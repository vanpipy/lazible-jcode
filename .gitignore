# secrets / live config (should never reach git)
# Allow the sanitized config.toml snapshot + example files
config/*
!config/config.toml
# But NEVER let a real mcp.json with tokens slip in
config/mcp.json

# Allow explicit subdirs that contain sanitized content (profiles, skills, etc.)
!config/profiles/
!config/policies/
!config/templates/
!config/skills/
!config/notes/
!config/mcp.example.json

# profiles : local drafts must never reach git
config/profiles/*.local.toml
config/profiles/*.secret.toml

# skills : local scratch from sync-skills experiments
config/skills/.scratch/

# merged / snapshot temporary dirs
config/.merged/
config/.snapshot-tmp/

# swarm runtime state : worker spawn manifests + scope files. These
# contain machine-specific paths (worktree locations, branch SHAs) and
# must never reach git.
.jcode/*

# jcode scratch dirs the harness creates at runtime. Safe to drop.
.git-commit-msg/
.git-spawn-scope/
.git-tmp/

# serena MCP : per-developer IDE/tool state. project.yml alone is
# already ignored in .serena/.gitignore; this catches the dir if a
# developer hasn't initialized serena in this repo yet.
.serena/

# macOS
.DS_Store

# editor
.vscode/
.idea/
*.swp
*.swo

# python bytecode (and import caches created by scripts/_lib_toml.py)
__pycache__/
*.pyc
scripts/_lib_toml.pyc

# build artifacts
target/
build/
dist/
*.log

# patched-jcode is a symlink to the local fork clone (created automatically
# by ./scripts/install on first run). The symlink itself is intentionally
# not committed : it points at a user-specific absolute path.
patched-jcode