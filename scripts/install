#!/usr/bin/env bash
# install : copy this config repo into ~/.jcode
#
# Usage:
#   ./scripts/install                 # install config (default)
#   ./scripts/install --dry-run       # show what would happen, no side effects
#   ./scripts/install --check         # verify live state, write nothing at all
#   ./scripts/install --help          # show this header
#
# This repo is CONFIG ONLY. It never builds, patches or installs jcode.
#
# What gets installed:
#   1. preflight  : deps (bash / python3 3.11+), writable paths, no symlinked config
#   2. config     : config/config.toml              -> ~/.jcode/config.toml
#   3. skills     : config/skills/*/SKILL.md        -> ~/.jcode/skills/*/
#   4. verify     : 6 checks
#   5. state      : ~/.local/state/lazible-jcode/state.json
#
# Not managed here:
#   - the jcode binary (install it separately)
#   - MCP servers (~/.jcode/mcp.json)
#   - ~/AGENTS.md (yours to edit)
#   - prompt-overlay.md and swarm-prompt.md. config/ holds a copy for review,
#     install only checks it against live and never overwrites live.
#
# Exit codes:
#   0  install succeeded, or --check found nothing wrong
#   1  preflight failed
#   6  a check failed. Under --check, prompt drift counts as a failure
#      too, since that mode asks whether anything at all is off.

set -euo pipefail

# shellcheck source=scripts/common.sh
. "$(dirname "$0")/common.sh"

dry_run=0
check_only=0

# Live prompt files. Mirrored into config/ for review, never written here.
LIVE_PROMPTS=(prompt-overlay.md swarm-prompt.md)

# The live path of every skill this repo owns.
#
# phase 3 copies into these, and the uninstaller removes them, so they are
# the paths that have to be checked against the repo boundary. They are
# listed here, once, so that the installer and the uninstaller agree on
# exactly which skills are in scope.
skill_targets=()
skill_names=()
for skill_src in "$REPO"/config/skills/*/; do
    skill_src="${skill_src%/}"
    [[ -f "$skill_src/SKILL.md" ]] || continue
    skill_names+=("$(basename "$skill_src")")
    skill_targets+=("$SKILLS_HOME/$(basename "$skill_src")")
done

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        --check)   check_only=1; shift ;;
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

section() { echo ""; echo "=== $* ==="; }

copy_file() {
    # copy_file <src> <dst> <mode>
    local src="$1" dst="$2" mode="$3"

    # The repo holds the source of truth. Writing into it, even by way of a
    # symlink, would overwrite the config this install is copying FROM.
    guard_outside_repo "$dst"

    if [[ $dry_run -eq 1 ]]; then
        echo "  would install: $src -> $dst"
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    install -m "$mode" "$src" "$dst"
}

# ---------------------------------------------------------------------------
# Phase 1: preflight
# ---------------------------------------------------------------------------

phase_preflight() {
    section "phase 1: preflight"

    local missing=()
    command -v bash    >/dev/null || missing+=("bash")
    command -v python3 >/dev/null || missing+=("python3")
    [[ ${#missing[@]} -eq 0 ]] || { err "missing deps: ${missing[*]}"; exit 1; }

    # python3 must be new enough for tomllib, which landed in 3.11.
    #
    # The version has to be checked HERE, in preflight, and not left to
    # phase 4. tomllib is used twice: to parse the installed config, and
    # (by the state writer) to read the repo's own config. On an older
    # python3 the import fails, so without this check the installer would
    # copy the config, copy the skills, and only then fail its own
    # verification, leaving a half-finished install behind with no state
    # file. A dependency that cannot work has to be caught before
    # anything is written.
    #
    # The check is on the VERSION, not on the import, so that the error
    # names the real problem. "import tomllib" would also fail on a
    # python3 that is 3.11+ but was built without the module, and the
    # message would be a confusing ModuleNotFoundError either way.
    local py_version py_ok=0
    py_version="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null)" \
        || py_version=""
    if [[ "$py_version" =~ ^([0-9]+)\.([0-9]+)$ ]]; then
        if (( BASH_REMATCH[1] > 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] >= 11) )); then
            py_ok=1
        fi
    fi
    if [[ $py_ok -eq 0 ]]; then
        err "python3 ${py_version:-<unknown>} is too old; tomllib needs 3.11 or newer"
        err "the installed config is parsed with tomllib, so an older python3 cannot install it"
        exit 1
    fi

    [[ -f "$REPO/config/config.toml" ]] || {
        err "missing $REPO/config/config.toml"; exit 1; }

    # The repo boundary is checked FIRST, before anything is created.
    #
    # Order matters here. The mkdir loop below would create ~/.jcode/skills
    # and the state directory, and if either path is a symlink into the repo
    # that mkdir would put a directory inside the repo before the refusal
    # ever ran. Checking first means a refusal leaves the repo untouched.
    #
    # The skills DIRECTORY is guarded as well as each skill's own directory.
    # The skill list alone would catch a redirected skill, but not a skills
    # directory that holds no skill this repo owns, and the mkdir loop
    # below would create that directory inside the repo.
    #
    # Each skill's OWN directory is guarded too, not just the skills
    # directory that holds them. A single skill directory symlinked into
    # the repo is the same hazard one level down: the guard on
    # $SKILLS_HOME alone would not see it, and the refusal would only
    # happen once phase 3 reached that skill, by which time phase 2 had
    # already written config.toml. Guarding it here keeps the refusal
    # up front, where nothing has been written yet.
    guard_outside_repo "$JCODE_CONFIG" "$SKILLS_HOME" "$STATE_DIR" "$STATE_FILE"
    guard_outside_repo "${skill_targets[@]}"

    # A symlinked config would let a write land in the repo base.
    if [[ -L "$JCODE_CONFIG" ]]; then
        err "$JCODE_CONFIG is a symlink -> $(readlink "$JCODE_CONFIG")"
        err "scripts refuse to write through it. Fix:"
        err "  rm $JCODE_CONFIG && cp $REPO/config/config.toml $JCODE_CONFIG"
        exit 1
    fi

    local d
    for d in "$HOME/.jcode" "$SKILLS_HOME" "$STATE_DIR"; do
        # Check first, then create. Checking first means --dry-run and the
        # real run fail with the same message instead of the real run
        # failing later inside mkdir with a raw "File exists".
        check_creatable_dir "$d"
        [[ -d "$d" ]] || run_mkdir "$d"
    done

    log "preflight ok"
}

run_mkdir() {
    if [[ $dry_run -eq 1 ]]; then
        echo "  would mkdir: $1"
    else
        mkdir -p "$1"
    fi
}

# The directory that would hold "$1", whether or not "$1" exists yet.
#
# Under --dry-run nothing is created, so a path like $HOME/.jcode may not
# exist at all. Writability then has to be judged by the nearest existing
# ancestor, because that is the directory the real install would have to
# create the path inside. Testing "$1" directly would fail on every clean
# machine and abort the preview.
#
# A symlink counts as existing even when its target does not: [[ -e ]]
# follows symlinks and is false for a dangling one, which would let this
# walk straight past a dangling ~/.jcode to an ancestor that looks writable.
# The real install would then fail at "mkdir: File exists", so the preview
# has to see it too.
nearest_existing_ancestor() {
    local probe="$1"
    while [[ ! -e "$probe" && ! -L "$probe" ]]; do
        local parent
        parent="$(dirname "$probe")"
        [[ "$parent" == "$probe" ]] && break
        probe="$parent"
    done
    printf '%s\n' "$probe"
}

# Check that "$1" can be created as a directory, or already is one.
#
# This mirrors what "mkdir -p" does, so that --dry-run predicts the real
# install instead of promising a success the real run would not deliver.
# The cases mkdir -p refuses are:
#   - the path exists and is not a directory
#   - the path is a dangling symlink ("File exists")
#   - some ancestor is not a directory
#   - the nearest existing ancestor is not writable
check_creatable_dir() {
    local d="$1"

    # A dangling symlink: [[ -e ]] is false but [[ -L ]] is true, and
    # mkdir -p refuses to replace it.
    if [[ -L "$d" && ! -e "$d" ]]; then
        err "$d is a dangling symlink -> $(readlink "$d")"
        err "mkdir cannot create it. Remove the link or point it at a directory."
        exit 1
    fi

    # The path exists but is not a directory.
    if [[ -e "$d" && ! -d "$d" ]]; then
        err "$d exists but is not a directory"
        err "mkdir cannot create it. Remove or rename the file first."
        exit 1
    fi

    if [[ -d "$d" ]]; then
        [[ -w "$d" ]] || { err "not writable: $d"; exit 1; }
        return 0
    fi

    # Not there yet. Walk up to the nearest existing ancestor and check
    # that it is a writable directory.
    local probe
    probe="$(nearest_existing_ancestor "$d")"
    if [[ ! -d "$probe" ]]; then
        err "$d cannot be created: $probe is not a directory"
        exit 1
    fi
    [[ -w "$probe" ]] || {
        err "not writable: $d (via $probe)"
        exit 1
    }
    return 0
}

# ---------------------------------------------------------------------------
# Phase 2: config
# ---------------------------------------------------------------------------

phase_config() {
    section "phase 2: config"
    copy_file "$REPO/config/config.toml" "$JCODE_CONFIG" 0644
    if [[ $dry_run -eq 1 ]]; then
        log "would install config: $JCODE_CONFIG"
    else
        log "config installed: $JCODE_CONFIG"
    fi
}

# ---------------------------------------------------------------------------
# Phase 3: skills
#
# Repo skills are authoritative and rewritten every install, so a stale or
# deleted copy under ~/.jcode/skills cannot silently drift.
# ---------------------------------------------------------------------------

phase_skills() {
    section "phase 3: skills"
    local n=0 name
    for name in "${skill_names[@]}"; do
        copy_file "$REPO/config/skills/$name/SKILL.md" \
            "$SKILLS_HOME/$name/SKILL.md" 0644
        n=$((n+1))
    done
    if [[ $dry_run -eq 1 ]]; then
        log "would install skills: $n"
    else
        log "skills installed: $n"
    fi
}

# ---------------------------------------------------------------------------
# Phase 4: verify
# ---------------------------------------------------------------------------

phase_verify() {
    section "phase 4: verify"

    if [[ $dry_run -eq 1 ]]; then
        echo "  would run 6 checks (skipped in --dry-run)"
        return 0
    fi

    local ok=0 fail=0 warn=0

    # Checks must survive individual failures so the full report prints.
    local saved_opts
    saved_opts="$-"
    set +e +o pipefail

    # check() and warn_check() below read $? from whatever command ran just
    # before them. That is this script's existing idiom, and it is correct
    # here: the tests immediately above each call site exit 0 or 1, and the
    # argument expansion does not clobber $?. shellcheck reads it as
    # ambiguous anyway, so the warning is disabled on purpose.
    check() {
        # shellcheck disable=SC2319
        if [[ $? -eq 0 ]]; then
            ok=$((ok+1)); echo "  ok   $1"
        else
            fail=$((fail+1)); echo "  FAIL $1"
        fi
    }

    # Prompt drift is not install's doing. install never writes these two
    # files, so a mismatch is something only the user can resolve, and
    # re-running install cannot fix it. Report it, but do not let it fail
    # an install whose own work all succeeded.
    warn_check() {
        # shellcheck disable=SC2319
        if [[ $? -eq 0 ]]; then
            ok=$((ok+1)); echo "  ok   $1"
        else
            warn=$((warn+1)); echo "  WARN $1"
        fi
    }

    python3 -c "import tomllib,sys; tomllib.load(open('$JCODE_CONFIG','rb'))"
    check "$JCODE_CONFIG parses"

    [[ ! -L "$JCODE_CONFIG" ]]
    check "$JCODE_CONFIG is a regular file, not a symlink"

    cmp -s "$REPO/config/config.toml" "$JCODE_CONFIG"
    check "live config matches config/config.toml"

    # Every repo skill must be present under ~/.jcode/skills, AND match
    # the repo's copy.
    #
    # The CONTENT comparison is not optional. The skills are rewritten on
    # every install, so a hand-edited copy under ~/.jcode/skills cannot
    # drift -- but that only holds if a check actually notices the drift.
    # A check that only looked for the file's existence would report
    # "all repo skills installed" for a skill whose content had been
    # edited, while a real install would overwrite that edit.
    #
    # The config right above is compared with cmp, so comparing the skills
    # the same way is what keeps the two consistent.
    #
    # Extra live skills are fine: this repo owns only what is under
    # config/skills/, so anything else jcode provides is left untouched.
    local missing_skills=() drifted_skills=() name
    for name in "${skill_names[@]}"; do
        if [[ ! -f "$SKILLS_HOME/$name/SKILL.md" ]]; then
            missing_skills+=("$name")
        elif ! cmp -s "$REPO/config/skills/$name/SKILL.md" \
            "$SKILLS_HOME/$name/SKILL.md"; then
            drifted_skills+=("$name")
        fi
    done
    [[ ${#missing_skills[@]} -eq 0 ]]
    check "all repo skills installed under ~/.jcode/skills${missing_skills:+ (missing: ${missing_skills[*]})}"

    [[ ${#drifted_skills[@]} -eq 0 ]]
    check "installed skills match the repo${drifted_skills:+ (differ: ${drifted_skills[*]})}"

    # Same reasoning as the skills check above: name the file that drifted,
    # not just the pair. A warning that says "one of these two differs"
    # makes the reader diff both to find out which one, and the fix is a
    # single copy per file.
    local f drifted_prompts=()
    for f in "${LIVE_PROMPTS[@]}"; do
        cmp -s "$REPO/config/$f" "$HOME/.jcode/$f" || drifted_prompts+=("$f")
    done
    [[ ${#drifted_prompts[@]} -eq 0 ]]
    warn_check "prompt-overlay.md / swarm-prompt.md vs live${drifted_prompts:+ (differ: ${drifted_prompts[*]})}"

    set -${saved_opts}

    echo ""
    echo "verify: $ok passed, $fail failed, $warn warning$([[ $warn -eq 1 ]] || echo s)"
    if [[ $warn -gt 0 ]]; then
        echo "note: prompt drift is not fixed by install. Copy the live file back:"
        echo "  cp ~/.jcode/prompt-overlay.md $REPO/config/prompt-overlay.md"
        echo "  cp ~/.jcode/swarm-prompt.md   $REPO/config/swarm-prompt.md"
    fi
    # Under --check the question is "is anything wrong?", so drift is a
    # failure there even though it is only a warning during a real install.
    [[ $check_only -eq 0 ]] || [[ $warn -eq 0 ]] || exit 6
    [[ $fail -eq 0 ]] || exit 6
}

# ---------------------------------------------------------------------------
# Phase 5: state
# ---------------------------------------------------------------------------

phase_finalize() {
    section "phase 5: state"

    if [[ $dry_run -eq 1 ]]; then
        echo "  would write: $STATE_FILE"
        echo ""
        echo "dry-run complete. re-run without --dry-run to actually install."
        exit 0
    fi

    # The state file lives outside the repo in normal use, but the same
    # symlink hazard applies: a redirected state path must not put a file
    # inside the repo.
    guard_outside_repo "$STATE_FILE"

    mkdir -p "$STATE_DIR"

    python3 - "$STATE_FILE" "$REPO" <<'PY'
import hashlib, json, os, sys, datetime
state_path, repo = sys.argv[1], sys.argv[2]

def sha(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()

config_sha = sha(os.path.join(repo, "config", "config.toml"))

# The skills this repo owns.
#
# A repo is allowed to hold no skills at all: the directory may not
# exist. The shell side builds its list from a glob, and a glob that
# matches nothing yields nothing, so the two sides have to agree. An
# os.listdir on a missing directory raises, which would abort the state
# write after the config had already been installed.
skills_dir = os.path.join(repo, "config", "skills")
skills = sorted(
    d for d in os.listdir(skills_dir)
    if os.path.isfile(os.path.join(skills_dir, d, "SKILL.md"))
) if os.path.isdir(skills_dir) else []

data = {
    "config_sha256": config_sha,
    "skills": skills,
    "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
}

# Keep the previous timestamp when nothing actually changed. "installed_at"
# then means when THIS config was installed, not when a script last ran.
# Without this, re-running install would rewrite the file every time and a
# second install would never be a no-op.
try:
    with open(state_path) as f:
        previous = json.load(f)
except (OSError, ValueError):
    previous = None

if previous is not None:
    same = (
        previous.get("config_sha256") == config_sha
        and previous.get("skills") == skills
        and isinstance(previous.get("installed_at"), str)
    )
    if same:
        data["installed_at"] = previous["installed_at"]

with open(state_path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
    log "state written: $STATE_FILE"

    echo ""
    echo "install complete"
    echo ""
    echo "  config:  $JCODE_CONFIG"
    echo "  skills:  $SKILLS_HOME"
    echo "  state:   $STATE_FILE"
    echo ""
    echo "The jcode binary is not managed here. Start a new shell to pick up changes."
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
    echo "lazible-jcode installer (config only)"
    echo ""
    echo "  config:  $JCODE_CONFIG"
    echo "  skills:  $SKILLS_HOME"
    echo "  state:   $STATE_FILE"
    echo ""
    [[ $dry_run -eq 1 ]] && echo "  mode: DRY-RUN (no side effects)"
    if [[ $check_only -eq 1 ]]; then
        echo "  mode: CHECK-ONLY (no side effects)"
    fi
    echo ""

    # --check is strictly read-only, so it skips preflight too: preflight
    # creates ~/.jcode and the state dir, which would not be read-only.
    if [[ $check_only -eq 1 ]]; then
        phase_verify
        exit 0
    fi

    phase_preflight
    phase_config
    phase_skills
    phase_verify
    phase_finalize
}

main
