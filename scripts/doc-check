#!/usr/bin/env bash
# doc-check : verify that the README's factual claims are actually true.
#
# The README makes promises about what the installer and the uninstaller do.
# A promise in prose is only worth as much as the check behind it, so this
# script turns those promises into assertions and runs them against the real
# scripts.
#
# Each check does two things:
#
#   1. it finds the claim in the README, and fails if the README no longer
#      states it in a form this script can read, and
#   2. it verifies the claim against the real code, and fails if the code
#      no longer keeps it.
#
# A doc that drifts from the code, and a code that drifts from the doc, both
# show up here as a failure.
#
# Everything runs against throwaway copies. Nothing here touches the real
# ~/.jcode or the real repo.

set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
README="$REPO/README.md"

# testlib.sh holds the helpers both test scripts share.
#
# It is separate from common.sh on purpose: common.sh sets `set -euo
# pipefail`, and these scripts drive commands that are expected to fail.
# A shared helper must not change how a script that sources it behaves.
# shellcheck source=scripts/testlib.sh
. "$(dirname "$0")/testlib.sh"

pass=0
fail=0

ok()  { pass=$((pass+1)); echo "  ok   $1"; }
bad() {
    fail=$((fail+1))
    echo "  FAIL $1"
    shift
    local detail
    for detail in "$@"; do echo "       $detail"; done
}

# check_claim <label> <readme-pattern> <description>
#
# The claim has to be findable in the README. If it is not, the README
# changed its wording and this check no longer knows what it was asserting.
check_claim() {
    local label="$1" pattern="$2"
    if grep -qF "$pattern" "$README"; then
        ok "$label"
    else
        bad "$label" "the README no longer states: $pattern"
    fi
}

# tree_fingerprint is in testlib.sh.

SANDBOX="$(mktemp -d "${TMPDIR:-/tmp}/lazible-doc-check.XXXXXX")"
trap 'rm -rf "$SANDBOX"' EXIT

echo "lazible-jcode doc check"
echo ""

# ---------------------------------------------------------------------------
# 1. the structure the README describes
# ---------------------------------------------------------------------------

echo "=== the README describes the real structure ==="

# "Five phases: preflight, config, skills, verify, state."
readme_phases="$(grep -o 'Five phases: [a-z, ]*' "$README" | head -1 |
    sed 's/^Five phases: //')"
code_phases="$(grep -o 'section "phase [0-9]*: [a-z]*"' "$REPO/scripts/install" |
    sed 's/.*: //; s/"$//' | tr '\n' ',' | sed 's/,$//')"
# The README writes "preflight, config, ..." with spaces, the code has
# "preflight,config,...". Normalise both to the same shape.
readme_phases_norm="$(echo "$readme_phases" | tr -d ' ')"
if [[ -n "$readme_phases" && "$readme_phases_norm" == "$code_phases" ]]; then
    ok "the README's phase list matches the installer's phases"
else
    bad "the README's phase list matches the installer's phases" \
        "README: $readme_phases" "code:   $code_phases"
fi

# "Verify ends with 6 checks."
check_count="$(grep -c '^\s*\(check\|warn_check\) "' "$REPO/scripts/install")"
if grep -q 'Verify ends with 6 checks' "$README" &&
   grep -q 'the same 6 checks' "$README" &&
   [[ "$check_count" -eq 6 ]]; then
    ok "the README's 6 checks match the installer's verify phase"
else
    bad "the README's 6 checks match the installer's verify phase" \
        "the installer's verify phase has $check_count check calls" \
        "the README says 6"
fi

# ---------------------------------------------------------------------------
# 2. the repo boundary
# ---------------------------------------------------------------------------

echo ""
echo "=== the README's repo boundary claims hold ==="

# A throwaway copy of the repo, used as the "repo" the symlinks point at.
# A check must never be able to damage the repository it runs in.
BOUNDARY_REPO="$SANDBOX/repo"
cp -r "$REPO" "$BOUNDARY_REPO"
rm -rf "$BOUNDARY_REPO/.git"
mkdir -p "$BOUNDARY_REPO/state-in-repo"

# A skills directory inside the repo whose own skill points back OUT of
# the repo. The skills-dir case below redirects the live skills dir at it.
#
# It is created BEFORE the fingerprint below, so the baseline includes it.
# A fixture added after the baseline would make the final comparison fail
# for the wrong reason: the test would be measuring its own setup.
mkdir -p "$BOUNDARY_REPO/other-skills" "$SANDBOX/outside-skill"
printf 'outside skill\n' > "$SANDBOX/outside-skill/SKILL.md"
ln -s "$SANDBOX/outside-skill" \
    "$BOUNDARY_REPO/other-skills/swarm-engineering"

boundary_before="$(tree_fingerprint "$BOUNDARY_REPO")"

# refuses <home> <state> <path> -> 0 if the install REFUSED for the
#                                  boundary reason, about <path>
#
# It checks the refusal MESSAGE, not just that the exit code was non-zero.
#
# A non-zero exit is not enough. The install can fail for reasons that have
# nothing to do with the repo boundary: a missing config, an unwritable
# home, a broken path. If this helper only asked "did it exit non-zero?",
# every boundary check below would pass whenever the installer failed for
# ANY reason, and the boundary claim would look proven by a script that
# never checked a single path.
#
# So the refusal has to be the boundary refusal: exit 1, and the message
# that says the path resolves inside the repo.
#
# The PATH matters too. The message names the offending path, so the
# check can insist on that exact path. Without it, an installer that
# refused some OTHER path inside the repo would satisfy a check about
# this one, and the check would prove nothing about the path it names.
refuses_install() {
    local home="$1" state="$2" path="$3" out rc
    out="$(HOME="$home" XDG_STATE_HOME="$state" \
        "$BOUNDARY_REPO/scripts/install" 2>&1)"
    rc=$?
    [[ "$rc" -eq 1 ]] || return 1
    grep -q 'resolves inside this repo' <<<"$out" || return 1
    grep -q 'refuses to touch it' <<<"$out" || return 1
    grep -qF "$path resolves inside this repo" <<<"$out" || return 1
    return 0
}

# The same, for the uninstaller.
#
# The uninstaller runs the REMOVAL guard, which has two checks:
#
#   1. the path resolves inside the repo
#   2. the ENTRY lives inside the repo, even when the path points out
#
# Check 1 fires when the target is a redirect into the repo. Check 2 fires
# when the entry rm would delete is inside the repo but the path points
# elsewhere. Both refuse, and both name the path.
#
# The two messages differ on purpose: "resolves inside" is about where
# the path points, "lives inside" is about where the entry is.
refuses_uninstall() {
    local home="$1" state="$2" path="$3" out rc
    out="$(HOME="$home" XDG_STATE_HOME="$state" \
        "$BOUNDARY_REPO/scripts/uninstall" --full --yes 2>&1)"
    rc=$?
    [[ "$rc" -eq 1 ]] || return 1
    grep -q 'inside this repo' <<<"$out" || return 1
    grep -q 'refuses to remove it' <<<"$out" || return 1
    grep -qF "$path " <<<"$out" || return 1
    grep -qE "($path resolves inside this repo|$path lives inside this repo)" <<<"$out" || return 1
    return 0
}

# The README lists the paths that are covered. Each one is redirected into
# the repo and has to cause a refusal.
#
# ~/.jcode/config.toml
mkdir -p "$SANDBOX/p1/home/.jcode"
ln -s "$BOUNDARY_REPO/config/config.toml" "$SANDBOX/p1/home/.jcode/config.toml"
if refuses_install "$SANDBOX/p1/home" "$SANDBOX/p1/state" \
    "$SANDBOX/p1/home/.jcode/config.toml"; then
    ok "a ~/.jcode/config.toml redirected into the repo is refused"
else
    bad "a ~/.jcode/config.toml redirected into the repo is refused" \
        "install did not refuse for the boundary reason"
fi

# ~/.jcode/skills/
mkdir -p "$SANDBOX/p2/home/.jcode"
ln -s "$BOUNDARY_REPO/config/skills" "$SANDBOX/p2/home/.jcode/skills"
if refuses_install "$SANDBOX/p2/home" "$SANDBOX/p2/state" \
    "$SANDBOX/p2/home/.jcode/skills"; then
    ok "a ~/.jcode/skills redirected into the repo is refused"
else
    bad "a ~/.jcode/skills redirected into the repo is refused" \
        "install did not refuse for the boundary reason"
fi

# the state directory
#
# The refusal names the state DIRECTORY, which is $XDG_STATE_HOME/
# lazible-jcode -- the path under the symlink, not the symlink itself.
mkdir -p "$SANDBOX/p3/home"
ln -s "$BOUNDARY_REPO/state-in-repo" "$SANDBOX/p3/state"
if refuses_install "$SANDBOX/p3/home" "$SANDBOX/p3/state" \
    "$SANDBOX/p3/state/lazible-jcode"; then
    ok "a state directory redirected into the repo is refused"
else
    bad "a state directory redirected into the repo is refused" \
        "install did not refuse for the boundary reason"
fi

# the state file
mkdir -p "$SANDBOX/p4/home" "$SANDBOX/p4/state/lazible-jcode"
ln -s "$BOUNDARY_REPO/state-in-repo/state.json" \
    "$SANDBOX/p4/state/lazible-jcode/state.json"
if refuses_install "$SANDBOX/p4/home" "$SANDBOX/p4/state" \
    "$SANDBOX/p4/state/lazible-jcode/state.json"; then
    ok "a state file redirected into the repo is refused"
else
    bad "a state file redirected into the repo is refused" "install did not refuse for the boundary reason"
fi

# Each skill's own directory. The README says the skills are covered, and
# a skill directory is a skills path one level down.
mkdir -p "$SANDBOX/p5/home/.jcode/skills"
ln -s "$BOUNDARY_REPO/config/skills/swarm-engineering" \
    "$SANDBOX/p5/home/.jcode/skills/swarm-engineering"
if refuses_install "$SANDBOX/p5/home" "$SANDBOX/p5/state" \
    "$SANDBOX/p5/home/.jcode/skills/swarm-engineering"; then
    ok "a skill's own directory redirected into the repo is refused"
else
    bad "a skill's own directory redirected into the repo is refused" \
        "install did not refuse for the boundary reason"
fi

# The skills DIRECTORY, with the skill inside it pointing back out.
#
# This is the case that proves the skills-directory guard does its own
# work. The skill path resolves outside the repo while the skills directory
# itself resolves inside it, so a guard on the skill list alone would see
# nothing wrong.
mkdir -p "$SANDBOX/p5b/home/.jcode"
ln -s "$BOUNDARY_REPO/other-skills" "$SANDBOX/p5b/home/.jcode/skills"
if refuses_install "$SANDBOX/p5b/home" "$SANDBOX/p5b/state" \
    "$SANDBOX/p5b/home/.jcode/skills"; then
    ok "a skills dir in the repo is refused even when the skill points out"
else
    bad "a skills dir in the repo is refused even when the skill points out" \
        "install did not refuse for the boundary reason"
fi

# "The check runs before the first mkdir, not when the write happens."
#
# A refusal has to leave nothing behind. If the check ran at write time,
# the config would already be in place.
mkdir -p "$SANDBOX/p6/home/.jcode/skills"
ln -s "$BOUNDARY_REPO/config/skills/swarm-engineering" \
    "$SANDBOX/p6/home/.jcode/skills/swarm-engineering"
HOME="$SANDBOX/p6/home" XDG_STATE_HOME="$SANDBOX/p6/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
if [[ -f "$SANDBOX/p6/home/.jcode/config.toml" ]]; then
    bad "a refused install writes nothing at all" \
        "config.toml was written before the refusal"
else
    ok "a refused install writes nothing at all"
fi

# "uninstall checks every path it intends to remove up front, so a refusal
# cannot leave a half-finished uninstall behind."
mkdir -p "$SANDBOX/p7/home" "$SANDBOX/p7/state"
HOME="$SANDBOX/p7/home" XDG_STATE_HOME="$SANDBOX/p7/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
rm -rf "$SANDBOX/p7/home/.jcode/skills/swarm-engineering"
ln -s "$BOUNDARY_REPO/config/skills/swarm-engineering" \
    "$SANDBOX/p7/home/.jcode/skills/swarm-engineering"
# The uninstall has to REFUSE. Checking only that nothing was removed
# would also pass if the uninstall had failed for an unrelated reason,
# which would prove nothing about the up-front check.
if refuses_uninstall "$SANDBOX/p7/home" "$SANDBOX/p7/state" \
    "$SANDBOX/p7/home/.jcode/skills/swarm-engineering"; then
    ok "a redirected skill makes the uninstall refuse"
else
    bad "a redirected skill makes the uninstall refuse" \
        "the uninstall did not refuse for the boundary reason"
fi
if [[ -f "$SANDBOX/p7/state/lazible-jcode/state.json" &&
      -f "$SANDBOX/p7/home/.jcode/config.toml" ]]; then
    ok "a refused uninstall removes nothing at all"
else
    bad "a refused uninstall removes nothing at all" \
        "the state file or the config was removed before the refusal"
fi

# "A refusal therefore leaves the repo byte-identical."
boundary_after="$(tree_fingerprint "$BOUNDARY_REPO")"
if [[ "$boundary_before" == "$boundary_after" ]]; then
    ok "a refusal leaves the repo byte-identical"
else
    bad "a refusal leaves the repo byte-identical" "the repo copy changed"
fi

# "A sibling directory whose name merely resembles the repo is not a match."
mkdir -p "$SANDBOX/lazible-jcode-backup"

# The guard harness needs its own repo-shaped directory.
#
# common.sh derives REPO from the location of the entry script, one level
# up from it. So the harness has to sit at "<repo>/scripts/<name>" for REPO
# to come out as "<repo>". It cannot live in the boundary copy's scripts
# directory, because that would overwrite the real installer the checks
# above run.
GUARD_REPO="$SANDBOX/guard-repo"
mkdir -p "$GUARD_REPO/scripts"
cp "$REPO/scripts/common.sh" "$GUARD_REPO/scripts/common.sh"

# It is called "install" so that common.sh's SCRIPT_NAME comes out as
# "install", the same as the real script. The README quotes the message the
# installer prints, and this is the message that has to match it.
cat > "$GUARD_REPO/scripts/install" <<'GUARD'
#!/usr/bin/env bash
set -uo pipefail
. "$(dirname "$0")/common.sh"
guard_outside_repo "$1"
GUARD
if bash "$GUARD_REPO/scripts/install" \
    "$SANDBOX/lazible-jcode-backup/config.toml" >/dev/null 2>&1; then
    ok "a sibling directory with a similar name is accepted"
else
    bad "a sibling directory with a similar name is accepted" \
        "the guard refused it"
fi

# ---------------------------------------------------------------------------
# 3. the quoted refusal message
# ---------------------------------------------------------------------------

echo ""
echo "=== the README quotes the real refusal message ==="

# The real message, produced by the guard itself.
real_msg="$(bash "$GUARD_REPO/scripts/install" \
    "$GUARD_REPO/config/config.toml" 2>&1 || true)"
real_line1="$(echo "$real_msg" | head -1)"
real_line2="$(echo "$real_msg" | sed -n 2p)"
real_line3="$(echo "$real_msg" | sed -n 3p)"

# The README's quote, with the path generalised so the two can be compared.
readme_line1="$(grep -m1 '^\[install\] ERR: .* resolves inside this repo$' "$README" || true)"
readme_line2="$(grep -m1 '^\[install\] ERR: install refuses to touch it\. Fix the symlink first:$' "$README" || true)"
readme_line3="$(grep -m1 '^\[install\] ERR:   rm .* && mkdir -p .*$' "$README" || true)"

if [[ -n "$readme_line1" && -n "$readme_line2" && -n "$readme_line3" ]]; then
    ok "the README quotes the refusal message"
else
    bad "the README quotes the refusal message" \
        "the quoted block is missing or has changed shape"
fi

# The shape of the message the README quotes has to match the shape the
# guard produces.
if [[ "$readme_line1" == \[install\]\ ERR:\ *\ resolves\ inside\ this\ repo ]]; then
    if [[ "$real_line1" == *' ERR: '*' resolves inside this repo' ]]; then
        ok "the quoted first line matches the real one"
    else
        bad "the quoted first line matches the real one" "real: $real_line1"
    fi
else
    bad "the quoted first line matches the real one" "readme: $readme_line1"
fi

if [[ "$readme_line2" == "$real_line2" ]]; then
    ok "the quoted second line matches the real one"
else
    bad "the quoted second line matches the real one" \
        "readme: $readme_line2" "real:   $real_line2"
fi

if [[ "$readme_line3" == "[install] ERR:   rm "*" && mkdir -p "* ]]; then
    if [[ "$real_line3" == *' ERR:   rm '*' && mkdir -p '* ]]; then
        ok "the quoted third line matches the real one"
    else
        bad "the quoted third line matches the real one" "real: $real_line3"
    fi
else
    bad "the quoted third line matches the real one" "readme: $readme_line3"
fi

# The preview has to PREDICT the real run.
#
# The README says "Preflight checks the same things in both modes, so a
# --dry-run that reports success is a promise the real install keeps."
# The boundary refusal is one of those preflight checks, so a dry run
# that skipped it would report success on a home that the real install
# is going to refuse.
mkdir -p "$SANDBOX/dryrefuse/home/.jcode"
ln -s "$BOUNDARY_REPO/config/config.toml" \
    "$SANDBOX/dryrefuse/home/.jcode/config.toml"
dryrefuse_out="$(HOME="$SANDBOX/dryrefuse/home" \
    XDG_STATE_HOME="$SANDBOX/dryrefuse/state" \
    "$BOUNDARY_REPO/scripts/install" --dry-run 2>&1)"
dryrefuse_rc=$?
if [[ "$dryrefuse_rc" -eq 1 ]]; then
    ok "install --dry-run exits 1 on a boundary violation"
else
    bad "install --dry-run exits 1 on a boundary violation" \
        "the dry run exited $dryrefuse_rc"
fi
if grep -q 'resolves inside this repo' <<<"$dryrefuse_out" &&
   grep -q 'refuses to touch it' <<<"$dryrefuse_out"; then
    ok "install --dry-run reports the boundary refusal"
else
    bad "install --dry-run reports the boundary refusal" \
        "the dry run did not report the refusal"
fi

# And it has to write nothing while refusing.
if [[ ! -e "$SANDBOX/dryrefuse/state/lazible-jcode/state.json" ]]; then
    ok "a refused install --dry-run writes no state file"
else
    bad "a refused install --dry-run writes no state file" \
        "a state file was written"
fi

# ---------------------------------------------------------------------------
# 4. running it twice
# ---------------------------------------------------------------------------

echo ""
echo "=== the README's idempotency claims hold ==="

idem_home="$SANDBOX/idem/home"
idem_state="$SANDBOX/idem/state"
idem_state_file="$idem_state/lazible-jcode/state.json"

idem_fingerprint() {
    tree_fingerprint "$idem_home"
    tree_fingerprint "$idem_state"
}

# The recorded timestamp has one second of resolution, so two installs in
# the same second are indistinguishable by construction. Every timestamp
# comparison waits for the clock to move on.
wait_for_next_second() {
    local now
    now="$(date +%S)"
    while [[ "$(date +%S)" == "$now" ]]; do
        sleep 0.05
    done
}

HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1

# "A second install with nothing changed is a no-op."
idem_before="$(idem_fingerprint)"
wait_for_next_second
HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
idem_after="$(idem_fingerprint)"
if [[ "$idem_before" == "$idem_after" ]]; then
    ok "a second install with nothing changed is a no-op"
else
    bad "a second install with nothing changed is a no-op" \
        "the install changed something"
fi

# "state.json keeps the timestamp of the install that actually wrote it."
installed_at_first="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
wait_for_next_second
HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
installed_at_second="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
if [[ "$installed_at_first" == "$installed_at_second" ]]; then
    ok "the recorded timestamp holds when nothing changed"
else
    bad "the recorded timestamp holds when nothing changed" \
        "before: $installed_at_first" "after:  $installed_at_second"
fi

# "The timestamp only moves when the config or the skill list actually
# changed."
printf '\n# a change\n' >> "$BOUNDARY_REPO/config/config.toml"
wait_for_next_second
HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
installed_at_third="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
if [[ "$installed_at_second" != "$installed_at_third" ]]; then
    ok "the recorded timestamp moves when the config changes"
else
    bad "the recorded timestamp moves when the config changes" \
        "the timestamp did not move: $installed_at_third"
fi

# The README's sentence has TWO halves: "the config OR the skill list
# actually changed". The config half is above. This is the skill half:
# the config is untouched, and only the skill list changes.
#
# Without this, a state writer that compared the config but ignored the
# skill list would satisfy every check so far, and the README would be
# stating something the code never did.
mkdir -p "$BOUNDARY_REPO/config/skills/second-skill"
printf '# second skill\n' > "$BOUNDARY_REPO/config/skills/second-skill/SKILL.md"
config_sha_before_skills="$(sha256sum "$BOUNDARY_REPO/config/config.toml" | cut -d' ' -f1)"
wait_for_next_second
HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
installed_at_fourth="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
if [[ "$installed_at_third" != "$installed_at_fourth" ]]; then
    ok "the recorded timestamp moves when the skill list changes"
else
    bad "the recorded timestamp moves when the skill list changes" \
        "the timestamp did not move: $installed_at_fourth"
fi

# The config really was untouched, so the move above can only have come
# from the skill list.
config_sha_after_skills="$(sha256sum "$BOUNDARY_REPO/config/config.toml" | cut -d' ' -f1)"
if [[ "$config_sha_before_skills" == "$config_sha_after_skills" ]]; then
    ok "the config was untouched while the skill list changed"
else
    bad "the config was untouched while the skill list changed" \
        "the config hash changed too"
fi

# Put the skill list back, so the rest of the suite sees the repo the
# README describes.
rm -rf "$BOUNDARY_REPO/config/skills/second-skill"

# A repo with NO skills at all has to install cleanly.
#
# The installer finds the skills it owns with a glob, and an unmatched
# glob yields nothing. The state writer had its own way of finding them
# and did not agree with the glob, so a repo with no skills used to
# crash in the last phase, after the config had already been installed.
mkdir -p "$SANDBOX/noskills"
cp -r "$REPO" "$SANDBOX/noskills/repo"
rm -rf "$SANDBOX/noskills/repo/.git"
rm -rf "$SANDBOX/noskills/repo/config/skills"
mkdir -p "$SANDBOX/noskills/home"
HOME="$SANDBOX/noskills/home" XDG_STATE_HOME="$SANDBOX/noskills/state" \
    "$SANDBOX/noskills/repo/scripts/install" >/dev/null 2>&1
noskills_rc=$?
if [[ "$noskills_rc" -eq 0 ]]; then
    ok "install succeeds for a repo with no skills"
else
    bad "install succeeds for a repo with no skills" \
        "the install exited $noskills_rc"
fi

# And the state file has to exist, recording an empty skill list.
noskills_state="$SANDBOX/noskills/state/lazible-jcode/state.json"
if [[ -f "$noskills_state" ]]; then
    noskills_recorded="$(python3 -c \
        "import json;print(json.load(open('$noskills_state'))['skills'])")"
    if [[ "$noskills_recorded" == "[]" ]]; then
        ok "a repo with no skills records an empty skill list"
    else
        bad "a repo with no skills records an empty skill list" \
            "the recorded list is $noskills_recorded"
    fi
else
    bad "a repo with no skills records an empty skill list" \
        "no state file at $noskills_state"
fi

# ---------------------------------------------------------------------------
# 5. the claims the README already made before this round
# ---------------------------------------------------------------------------

echo ""
echo "=== the README's other claims still hold ==="

# "install never writes prompt-overlay.md or swarm-prompt.md"
mkdir -p "$SANDBOX/pr/home"
HOME="$SANDBOX/pr/home" XDG_STATE_HOME="$SANDBOX/pr/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
if [[ ! -f "$SANDBOX/pr/home/.jcode/prompt-overlay.md" &&
      ! -f "$SANDBOX/pr/home/.jcode/swarm-prompt.md" ]]; then
    ok "install never writes the two prompt files"
else
    bad "install never writes the two prompt files" "a prompt file was written"
fi

# "The jcode binary and ~/AGENTS.md are never removed."
mkdir -p "$SANDBOX/pr/home/.local/bin"
touch "$SANDBOX/pr/home/.local/bin/jcode"
touch "$SANDBOX/pr/home/AGENTS.md"
HOME="$SANDBOX/pr/home" XDG_STATE_HOME="$SANDBOX/pr/state" \
    "$BOUNDARY_REPO/scripts/uninstall" --full --yes >/dev/null 2>&1
if [[ -f "$SANDBOX/pr/home/.local/bin/jcode" &&
      -f "$SANDBOX/pr/home/AGENTS.md" ]]; then
    ok "uninstall never removes the jcode binary or ~/AGENTS.md"
else
    bad "uninstall never removes the jcode binary or ~/AGENTS.md" \
        "one of them was removed"
fi

# "--full does remove ~/.jcode/skills/swarm-engineering/."
if [[ ! -e "$SANDBOX/pr/home/.jcode/skills/swarm-engineering" ]]; then
    ok "uninstall --full removes the repo's own skill"
else
    bad "uninstall --full removes the repo's own skill" "the skill is still there"
fi

# "Every directory under config/skills/ that holds a SKILL.md is a skill
# this repo owns."
#
# The repo ships exactly one skill, so this has to be checked against a
# copy that holds two. A list that stopped at the first skill would copy
# one and leave the other behind, and nothing else here would notice.
mkdir -p "$SANDBOX/skills"
cp -r "$REPO" "$SANDBOX/skills/repo"
rm -rf "$SANDBOX/skills/repo/.git"
mkdir -p "$SANDBOX/skills/repo/config/skills/second-skill"
printf '# second skill\n' > "$SANDBOX/skills/repo/config/skills/second-skill/SKILL.md"
mkdir -p "$SANDBOX/skills/repo/config/skills/not-a-skill"
printf 'stray\n' > "$SANDBOX/skills/repo/config/skills/not-a-skill/NOTES.md"
mkdir -p "$SANDBOX/skills/home" "$SANDBOX/skills/state"

HOME="$SANDBOX/skills/home" XDG_STATE_HOME="$SANDBOX/skills/state" \
    "$SANDBOX/skills/repo/scripts/install" >/dev/null 2>&1

if [[ -f "$SANDBOX/skills/home/.jcode/skills/second-skill/SKILL.md" &&
      -f "$SANDBOX/skills/home/.jcode/skills/swarm-engineering/SKILL.md" ]]; then
    ok "install copies every skill the repo owns"
else
    bad "install copies every skill the repo owns" \
        "the live skills dir holds: $(find "$SANDBOX/skills/home/.jcode/skills" -mindepth 1 -maxdepth 1 -exec basename {} \; 2>/dev/null | sort | tr '\n' ' ')"
fi

if [[ ! -e "$SANDBOX/skills/home/.jcode/skills/not-a-skill" ]]; then
    ok "install ignores a directory that is not a skill"
else
    bad "install ignores a directory that is not a skill" "not-a-skill was copied"
fi

# "Skills in this repo are rewritten on every install, so a hand-edited
# copy under ~/.jcode/skills/ cannot drift."
#
# That claim has two halves, and only the first was ever checked.
#
# The first half is that the install REWRITES the skill. That was already
# covered by the idempotency checks: a second install changes nothing,
# and the installed copy matches the repo.
#
# The second half is that a drifted copy gets FIXED, and that --check
# can SEE the drift. The skill check used to look for the file's
# existence, so an edited skill still reported "all repo skills
# installed" as ok, while a real install would have overwritten the
# edit. The config right above was compared with cmp, so the skills are
# now compared the same way.
#
# The skill is edited AFTER the install, so the install cannot have
# overwritten the edit itself.
printf '\n# a local edit\n' >> "$SANDBOX/skills/home/.jcode/skills/second-skill/SKILL.md"

set +e
skills_check_out="$(HOME="$SANDBOX/skills/home" XDG_STATE_HOME="$SANDBOX/skills/state" \
    "$SANDBOX/skills/repo/scripts/install" --check 2>&1)"
skills_check_rc=$?
set -e

if [[ "$skills_check_rc" -eq 6 ]] &&
   grep -q 'installed skills match the repo' <<<"$skills_check_out" &&
   grep -q 'second-skill' <<<"$skills_check_out"; then
    ok "--check reports a skill whose content drifted"
else
    bad "--check reports a skill whose content drifted" \
        "the check exited $skills_check_rc" "$skills_check_out"
fi

# And a real install puts it back.
HOME="$SANDBOX/skills/home" XDG_STATE_HOME="$SANDBOX/skills/state" \
    "$SANDBOX/skills/repo/scripts/install" >/dev/null 2>&1
if cmp -s "$SANDBOX/skills/repo/config/skills/second-skill/SKILL.md" \
    "$SANDBOX/skills/home/.jcode/skills/second-skill/SKILL.md"; then
    ok "a real install restores a skill whose content drifted"
else
    bad "a real install restores a skill whose content drifted" \
        "the installed skill still differs from the repo"
fi

# "A skill under ~/.jcode/skills/ that this repo does not own is left
# alone by the uninstaller."
mkdir -p "$SANDBOX/skills/home/.jcode/skills/someone-elses-skill"
printf 'not ours\n' > "$SANDBOX/skills/home/.jcode/skills/someone-elses-skill/SKILL.md"
HOME="$SANDBOX/skills/home" XDG_STATE_HOME="$SANDBOX/skills/state" \
    "$SANDBOX/skills/repo/scripts/uninstall" --full --yes >/dev/null 2>&1

if [[ ! -e "$SANDBOX/skills/home/.jcode/skills/second-skill" &&
      ! -e "$SANDBOX/skills/home/.jcode/skills/swarm-engineering" ]]; then
    ok "uninstall --full removes every skill the repo owns"
else
    bad "uninstall --full removes every skill the repo owns" \
        "the live skills dir holds: $(find "$SANDBOX/skills/home/.jcode/skills" -mindepth 1 -maxdepth 1 -exec basename {} \; 2>/dev/null | sort | tr '\n' ' ')"
fi

if [[ -f "$SANDBOX/skills/home/.jcode/skills/someone-elses-skill/SKILL.md" ]]; then
    ok "uninstall leaves a skill the repo does not own"
else
    bad "uninstall leaves a skill the repo does not own" \
        "the other skill was removed"
fi

# ---------------------------------------------------------------------------
# 5b. the drift warning names the file that drifted
#
# The README quotes the warning line:
#
#   WARN prompt-overlay.md / swarm-prompt.md vs live (differ: swarm-prompt.md)
#
# A README that quotes output has to quote the REAL output. The check
# below drifts one of the two prompt files and asks the installer what it
# prints, then compares that against the line the README shows.
# ---------------------------------------------------------------------------

echo ""
echo "=== the drift warning names the file that drifted ==="

# Fresh sandbox: the skills sandbox has had its live prompt files
# removed by the uninstall above.
mkdir -p "$SANDBOX/drift/home/.jcode"
cp "$SANDBOX/skills/repo/config/prompt-overlay.md" "$SANDBOX/drift/home/.jcode/prompt-overlay.md"
cp "$SANDBOX/skills/repo/config/swarm-prompt.md" "$SANDBOX/drift/home/.jcode/swarm-prompt.md"

# Drift exactly one of the two.
printf '\nlocal hand edit\n' >> "$SANDBOX/drift/home/.jcode/swarm-prompt.md"

set +e
drift_out="$(HOME="$SANDBOX/drift/home" XDG_STATE_HOME="$SANDBOX/drift/state" \
    "$SANDBOX/skills/repo/scripts/install" --check 2>&1)"
drift_rc=$?
set -e

drift_warn="$(grep -m1 'vs live' <<<"$drift_out" | sed 's/^[[:space:]]*//')"

# The README's quoted line, minus the leading two spaces. The `|| true`
# matters: if the README stops quoting the warning at all, grep finds
# nothing and returns non-zero, which under `set -e` would abort the
# whole run before the remaining checks got a chance to run.
readme_drift_warn="$(grep -m1 'vs live' "$README" | sed 's/^[[:space:]]*//' || true)"

if [[ "$drift_rc" -eq 6 ]] &&
   [[ "$drift_warn" == "WARN prompt-overlay.md / swarm-prompt.md vs live (differ: swarm-prompt.md)" ]]; then
    ok "--check names the prompt file that drifted"
else
    bad "--check names the prompt file that drifted" \
        "the check exited $drift_rc" "it printed: $drift_warn"
fi

# And the README has to quote that same line, so the doc and the code
# cannot drift apart without this check noticing.
if [[ "$readme_drift_warn" == "$drift_warn" ]]; then
    ok "the README quotes the real drift warning"
else
    bad "the README quotes the real drift warning" \
        "the README shows: $readme_drift_warn" "the installer prints: $drift_warn"
fi

# ---------------------------------------------------------------------------
# 6. the "not managed here" guarantees
#
# The README lists four categories of file the scripts never touch. Only
# the binary and ~/AGENTS.md were checked, and both by the same two-file
# assertion above. The other two categories were prose with nothing
# behind them.
#
# One artifact per category is planted, and every one of them has to
# survive BOTH the install and the --full uninstall. The --full uninstall
# is the one that matters: it is the mode that removes things.
# ---------------------------------------------------------------------------

echo ""
echo "=== the files the README does not manage survive ==="

mkdir -p "$SANDBOX/unmanaged/home/.jcode/sessions/abc123" \
         "$SANDBOX/unmanaged/home/.jcode/goals/global" \
         "$SANDBOX/unmanaged/state"

printf 'session transcript\n' > "$SANDBOX/unmanaged/home/.jcode/sessions/abc123/turns.jsonl"
printf 'goal history\n' > "$SANDBOX/unmanaged/home/.jcode/goals/global/goal-1.json"
printf '{"meadow":{"pid":1}}\n' > "$SANDBOX/unmanaged/home/.jcode/servers.json"
printf '{"mcpServers":{}}\n' > "$SANDBOX/unmanaged/home/.jcode/mcp.json"
printf 'settings\n' > "$SANDBOX/unmanaged/home/.jcode/settings.json"

# The paths the README names, relative to the sandbox HOME.
unmanaged_paths=(
    ".jcode/sessions/abc123/turns.jsonl"
    ".jcode/goals/global/goal-1.json"
    ".jcode/servers.json"
    ".jcode/mcp.json"
    ".jcode/settings.json"
)

# The CONTENT of the unmanaged files, before anything runs. An existence
# check would miss an install that overwrote a file with different bytes
# and left it in place.
unmanaged_fingerprint() {
    local p out=""
    for p in "${unmanaged_paths[@]}"; do
        if [[ -e "$SANDBOX/unmanaged/home/$p" ]]; then
            out+="$p=$(sha256sum < "$SANDBOX/unmanaged/home/$p" | cut -d' ' -f1)
"
        else
            out+="$p=REMOVED
"
        fi
    done
    printf '%s' "$out"
}

unmanaged_before="$(unmanaged_fingerprint)"

HOME="$SANDBOX/unmanaged/home" XDG_STATE_HOME="$SANDBOX/unmanaged/state" \
    "$REPO/scripts/install" >/dev/null 2>&1
for p in "${unmanaged_paths[@]}"; do
    if [[ -e "$SANDBOX/unmanaged/home/$p" ]]; then
        ok "install leaves $p alone"
    else
        bad "install leaves $p alone" "it was removed"
    fi
done
if [[ "$(unmanaged_fingerprint)" == "$unmanaged_before" ]]; then
    ok "install leaves every unmanaged file byte-identical"
else
    bad "install leaves every unmanaged file byte-identical" \
        "the content of an unmanaged file changed"
fi

HOME="$SANDBOX/unmanaged/home" XDG_STATE_HOME="$SANDBOX/unmanaged/state" \
    "$REPO/scripts/uninstall" --full --yes >/dev/null 2>&1
for p in "${unmanaged_paths[@]}"; do
    if [[ -e "$SANDBOX/unmanaged/home/$p" ]]; then
        ok "uninstall --full leaves $p alone"
    else
        bad "uninstall --full leaves $p alone" "it was removed"
    fi
done
if [[ "$(unmanaged_fingerprint)" == "$unmanaged_before" ]]; then
    ok "uninstall --full leaves every unmanaged file byte-identical"
else
    bad "uninstall --full leaves every unmanaged file byte-identical" \
        "the content of an unmanaged file changed"
fi

# The uninstall has to have actually removed what it owns, or the checks
# above would pass on a run that removed nothing at all.
if [[ ! -e "$SANDBOX/unmanaged/home/.jcode/config.toml" ]]; then
    ok "uninstall --full removed the config it owns"
else
    bad "uninstall --full removed the config it owns" "the config is still there"
fi

# ---------------------------------------------------------------------------
# 7. the python3 version requirement is enforced, not just stated
#
# The README requires python3 3.11 or newer, because tomllib landed in
# 3.11. Preflight used to check only that python3 EXISTED, so on an older
# python3 the installer copied the config and the skills and then failed
# its own verification, exiting 6 with a half-finished install and no
# state file behind it.
#
# The refusal has to be in preflight, so the exit code has to be 1 and
# not 6, and nothing may have been written.
# ---------------------------------------------------------------------------

echo ""
echo "=== an old python3 is refused before anything is written ==="

mkdir -p "$SANDBOX/oldpy/bin" "$SANDBOX/oldpy/home" "$SANDBOX/oldpy/state"
cat > "$SANDBOX/oldpy/bin/python3" <<'STUB'
#!/usr/bin/env bash
for a in "$@"; do
    case "$a" in
        *'sys.version_info[:2]'*)
            echo "3.10"
            exit 0
            ;;
        *tomllib*)
            echo "ModuleNotFoundError: No module named 'tomllib'" >&2
            exit 1
            ;;
    esac
done
exec /usr/bin/python3 "$@"
STUB
chmod +x "$SANDBOX/oldpy/bin/python3"

set +e
oldpy_out="$(PATH="$SANDBOX/oldpy/bin:$PATH" \
    HOME="$SANDBOX/oldpy/home" XDG_STATE_HOME="$SANDBOX/oldpy/state" \
    "$REPO/scripts/install" 2>&1)"
oldpy_rc=$?
set -e

if [[ "$oldpy_rc" -eq 1 ]] && grep -q 'tomllib' <<<"$oldpy_out"; then
    ok "install refuses a python3 older than 3.11 in preflight"
else
    bad "install refuses a python3 older than 3.11 in preflight" \
        "the install exited $oldpy_rc" "$oldpy_out"
fi

if [[ ! -e "$SANDBOX/oldpy/home/.jcode/config.toml" ]]; then
    ok "an old python3 is refused before the config is written"
else
    bad "an old python3 is refused before the config is written" \
        "the config was written"
fi

# ---------------------------------------------------------------------------
# 8. the README has to actually state the claims
# ---------------------------------------------------------------------------

echo ""
echo "=== the README states the claims this script checks ==="

check_claim "the README states the repo boundary" \
    "Neither script may write into it or"
check_claim "the README states the up-front check" \
    "The check runs before the first"
check_claim "the README states the atomic uninstall" \
    "uninstall\` checks every path it intends to remove up front"
check_claim "the README states the idempotency" \
    "A second install with nothing changed is a no-op"
check_claim "the README states the timestamp meaning" \
    "The timestamp only moves when the config or the skill list actually changed"
check_claim "the README states the skill drift check" \
    "compares the installed skills"
check_claim "the README states the per-skill boundary" \
    "Each skill's own directory is covered too"
check_claim "the README states the skill list rule" \
    "Every directory under \`config/skills/\` that holds a \`SKILL.md\`"
check_claim "the README states that a refusal is not just a failure" \
    "A refusal has to be a refusal, not just a failure"
check_claim "the README documents the doc-check script" \
    "./scripts/doc-check"
check_claim "the README documents the test library" \
    "scripts/testlib.sh"
check_claim "the README states the python3 version requirement" \
    "python3\` 3.11 or newer"
check_claim "the README states that the python3 version is checked" \
    "the installer checks it"
check_claim "the README states the MCP config path" \
    "MCP servers, they live in \`~/.jcode/mcp.json\`"
check_claim "the README states that servers.json is not the MCP config" \
    "is not the MCP config"
check_claim "the README states that the unmanaged files are checked" \
    "it plants one artifact per category"
check_claim "the README states that mcp.json is not tracked" \
    "**not tracked**"

# ---------------------------------------------------------------------------

echo ""
echo "doc check: $pass passed, $fail failed"
[[ "$fail" -eq 0 ]]
