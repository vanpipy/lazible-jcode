# secrets / live config (should never reach git)
# Allow the sanitized config.toml snapshot + example files
config/*
!config/config.toml
# But NEVER let a real mcp.json with tokens slip in
config/mcp.json

# Allow explicit subdirs that contain sanitized content
!config/bin/
!config/policies/
!config/share/
!config/skills/
!config/templates/
!config/mcp.example.json

# skills : local scratch from sync-skills experiments
config/skills/.scratch/

# swarm runtime state : worker spawn manifests + scope files. These
# contain machine-specific paths (worktree locations, branch SHAs) and
# must never reach git.
.jcode/*

# jcode scratch dirs the harness creates at runtime. Safe to drop.
.git-commit-msg/
.git-spawn-scope/
.git-tmp/

# serena MCP : per-developer IDE/tool state. project.yml alone is
# already ignored in .serena/.gitignore; this catches the dir if a
# developer hasn't initialized serena in this repo yet.
.serena/

# editor scratch
.scratch/

# macOS
.DS_Store

# editor
.vscode/
.idea/
*.swp
*.swo

# python bytecode
__pycache__/
*.pyc
config/bin/__pycache__/

# build artifacts
target/
build/
dist/
*.log
