#!/usr/bin/env python3
"""measure-rule-tools : the miss rate of the two rule tools.

    ./scripts/measure-rule-tools <file> <ref>

For every rule in the baseline, delete that one rule, re-score the file, and
ask whether the tool still reports that rule as kept. A tool that still
reports it kept cannot see the deletion, so it misses.

The measure is per tool and per rule set, because the two tools do not
collect the same rules. rule-inventory collects a rule per sentence and
per bullet line. rule-drop collects a rule per bullet and per sentence of a
paragraph. Each is measured on the rules it collects.

A false positive is the other direction: after the deletion, a rule that
survived is reported as gone. A tool with false positives cries wolf, and a
reviewer stops reading its report.
"""
from __future__ import annotations

import importlib.machinery
import importlib.util
import pathlib
import re
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent


def load(name: str, path: pathlib.Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ri = load("ri", REPO / "scripts" / "rule-inventory")
rd = load("rd", REPO / "scripts" / "rule-drop")


def git_show(ref: str, path: str) -> str:
    out = subprocess.run(["git", "show", f"{ref}:{path}"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"cannot read {ref}:{path}")
    return out.stdout


def delete_rule(text: str, target: str) -> str | None:
    """Delete one rule from the text, at the level the text is built from.

    A rule is a bullet, a numbered item, or a sentence of a paragraph. The
    deletion has to remove the rule's own words and nothing else, so the
    deletion is done on the unit that holds it.

    A bullet's continuation lines belong to the bullet, so the deletion
    removes the bullet and the lines that continue it. The rule text is
    compared in the joined form, because that is the form the tool reads.
    """
    lines = text.splitlines(keepends=True)
    out: list[str] = []
    i = 0
    removed = False
    while i < len(lines):
        line = lines[i]
        body = line.strip()
        if not body:
            out.append(line)
            i += 1
            continue
        if body.startswith("#"):
            out.append(line)
            i += 1
            continue

        # A bullet, a numbered item, or a paragraph. Collect the unit and
        # the lines that continue it.
        start = i
        if re.match(r"^([-*]|\d+\.)\s+", body):
            i += 1
            while i < len(lines):
                nxt = lines[i].strip()
                if not nxt or nxt.startswith("#") or re.match(r"^([-*]|\d+\.)\s+", nxt):
                    break
                i += 1
        else:
            # A paragraph runs to the next blank line.
            i += 1
            while i < len(lines) and lines[i].strip():
                i += 1

        unit_lines = lines[start:i]
        unit = " ".join(ln.strip() for ln in unit_lines if ln.strip())

        if target not in unit:
            out.extend(unit_lines)
            continue

        if re.match(r"^([-*]|\d+\.)\s+", body):
            # The rule is the bullet. Remove it and its continuations.
            removed = True
            out.append("\n")
            continue

        # The rule is a sentence of a paragraph.
        sentences = rd.SENTENCE_SPLIT.split(unit)
        kept_sentences = [s for s in sentences if s.strip() != target]
        if kept_sentences and len(kept_sentences) < len(sentences):
            removed = True
            out.append("\n".join(kept_sentences) + "\n")
            continue

        # The unit holds the rule but not as its own sentence. The rule was
        # collected from a bullet inside it, so drop the bullet.
        kept_lines = []
        skipping = False
        for ln in unit_lines:
            if re.match(r"^([-*]|\d+\.)\s+", ln.strip()):
                skipping = target in ln
                if skipping:
                    continue
            elif skipping:
                continue
            kept_lines.append(ln)
        if kept_lines:
            removed = True
            out.append("".join(kept_lines))
            continue

        # The rule could not be located on its own. Leave the unit alone.
        out.extend(unit_lines)
    if not removed:
        return None
    return "".join(out)


def inventory_still_kept(text: str, target: str) -> bool:
    """Does rule-inventory still report this rule as kept?"""
    before_rows = ri.inventory(target)
    if not before_rows:
        return True
    norm = before_rows[0][1]
    words = ri.content_words(norm)
    if not words:
        return True
    after_terms = set(ri.stem(w) for w in re.findall(r"[a-z0-9]+", text.lower()))
    return ri.coverage(norm, after_terms) >= 0.5


def drop_still_kept(text: str, target: str) -> bool:
    """Does rule-drop still find a counterpart for this rule?"""
    before_rules = rd.rules_of(target)
    if not before_rules:
        return True
    norm = before_rules[0][0]
    words = ri.content_words(norm)
    if not words:
        return True
    candidates = rd.rules_of(text)
    score, _ = rd.best_match(norm, candidates)
    return score >= rd.THRESHOLD


def measure(tool_rules: list[str], base_text: str, kept_fn) -> tuple[int, int, int]:
    """(missed, false positives, deletions attempted) for one tool."""
    missed = 0
    false_positives = 0
    attempted = 0
    for raw in tool_rules:
        text = delete_rule(base_text, raw)
        if text is None or text == base_text:
            continue
        attempted += 1
        if kept_fn(text, raw):
            missed += 1
        else:
            # A surviving rule reported as gone is a false positive.
            for other in tool_rules:
                if other == raw:
                    continue
                if not kept_fn(text, other):
                    false_positives += 1
                    break
    return missed, false_positives, attempted


def main(argv: list[str]) -> int:
    if len(argv) < 3:
        print(__doc__)
        return 2
    path, ref = argv[1], argv[2]
    base_text = git_show(ref, path)

    inv_rules = [raw for _, _, raw in ri.inventory(base_text)]
    drop_rules = [raw for _, raw in rd.rules_of(base_text)]

    ri_missed, ri_fp, ri_tried = measure(inv_rules, base_text, inventory_still_kept)
    rd_missed, rd_fp, rd_tried = measure(drop_rules, base_text, drop_still_kept)

    print(f"# {path} at {ref}")
    print(f"# rule-inventory: {len(inv_rules)} rules, "
          f"missed {ri_missed} of {ri_tried} deletions "
          f"({ri_missed / ri_tried:.0%}), false positives {ri_fp}")
    print(f"# rule-drop: {len(drop_rules)} rules, "
          f"missed {rd_missed} of {rd_tried} deletions "
          f"({rd_missed / rd_tried:.0%}), false positives {rd_fp}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
