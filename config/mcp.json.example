{
  "_comment": [
    "Reference ~/.jcode/mcp.json (live) and .jcode/mcp.json (per-project).",
    "Both canonical mcpServers and legacy servers keys are accepted.",
    "jcode currently supports stdio (command-based) servers only; http/sse",
    "entries are recognized and skipped with a log line.",
    "On first run, jcode imports MCP servers from ~/.claude.json (falling",
    "back to ~/.claude/mcp.json) and ~/.codex/config.toml if this file does",
    "not exist yet.",
    "",
    "Recommended local-only stack (no external API auth required):",
    "  - filesystem: scoped file I/O, safer than unrestricted bash read/write",
    "  - git:        structured local git ops (log/blame/diff/branch)",
    "  - serena:     code intelligence (symbols, refs, rename) via tree-sitter",
    "",
    "Each entry below assumes the server binary is on PATH (npx / uvx will",
    "fetch on first run). Replace /workspace with the actual project root.",
    "",
    "Verified working as of 2026-08-16 against serena-agent v1.28.1,",
    "@modelcontextprotocol/server-filesystem 2026.7.10, and",
    "@cyanheads/git-mcp-server v2.15.1. sqlite is intentionally NOT in the",
    "stack — every sqlite MCP server currently published (mcp-sqlite,",
    "sqlite-mcp, mcp-server-sqlite) either fails the JSON-RPC handshake or",
    "produces no output on stdout. Use jcode-native `bash` + the `sqlite3`",
    "CLI for database inspection until a working sqlite MCP server exists."
  ],
  "mcpServers": {
    "filesystem": {
      "_comment": "Scoped filesystem access. Replace the trailing path with your project root.",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
      "env": {},
      "shared": true
    },
    "git": {
      "_comment": "Local git ops (status/log/diff/blame/branch/commit/checkout). Auto-discovers repo from cwd.",
      "command": "npx",
      "args": ["-y", "@cyanheads/git-mcp-server"],
      "env": {},
      "shared": true
    },
    "serena": {
      "_comment": "Code intelligence via tree-sitter (oraios/serena). No external LSP install needed for Python/TS/Java/Go. See docs/INTEGRATIONS.md.",
      "command": "uvx",
      "args": ["serena-agent", "start-mcp-server", "--project", "/workspace"],
      "env": {},
      "shared": true
    }
  }
}