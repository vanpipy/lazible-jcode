#!/usr/bin/env bash
# uninstall : reverse: remove artifacts left behind by install
#
# Usage:
#   ./scripts/uninstall                  # default: remove CLIs + hook + prompts + state
#   ./scripts/uninstall --dry-run        # print what would be removed, do nothing
#   ./scripts/uninstall --full           # also remove config + skills + shell env (requires --yes)
#   ./scripts/uninstall --yes            # skip all confirmation prompts
#   ./scripts/uninstall --help           # show help
#
# Default behavior (low impact) removes:
#   - $HOME/.local/bin/jcode-{goal,l2-check,tool-policy,orchestrate}
#   - $HOME/.local/bin/jcode-audit-log
#   - $HOME/.local/share/jcode-orchestrate/prompts/
#   - $XDG_STATE_HOME/lazible-jcode/state.json
#
# --full (high impact, requires --yes for a second confirmation) also removes:
#   - $HOME/.jcode/config.toml
#   - $HOME/.jcode/skills/<name> for every name in $REPO/config/skills/
#   - the jcode env block in ~/.zshrc and ~/.bashrc
#
# Always preserved:
#   - $HOME/AGENTS.md            # your personal global instructions, edited by you
#   - $HOME/.local/bin/jcode     # the jcode binary. This repo does not install it.
#   - $HOME/.jcode/ambient/, state/, sessions/, logs/   # runtime state
#   - $HOME/.jcode/goals/        # goal history
#
# Design constraints:
#   - uninstall never removes the jcode binary. This repo does not own it.
#   - default is the safe scope; --yes is required for the --full parts
#   - any missing path is not an error (idempotent)

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

LOCAL_BIN="$HOME/.local/bin"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lazible-jcode"
STATE_FILE="$STATE_DIR/state.json"
JCODE_CONFIG="$HOME/.jcode/config.toml"
SKILLS_HOME="$HOME/.jcode/skills"
AUDIT_LOG="$LOCAL_BIN/jcode-audit-log"
PROMPTS_DST="$HOME/.local/share/jcode-orchestrate/prompts"

CLI_NAMES=(jcode-goal jcode-l2-check jcode-tool-policy jcode-orchestrate)

full=0
yes=0
dry_run=0

usage() {
    sed -n '2,33p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full)    full=1; shift ;;
        --yes)     yes=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

log() { echo "[uninstall] $*"; }

# remove a file/dir if present (no error when absent)
rm_safe() {
    if [[ -e "$1" || -L "$1" ]]; then
        log "rm $1"
        [[ $dry_run -eq 0 ]] && rm -rf "$1"
    else
        log "skip $1 (not present)"
    fi
    return 0
}

confirm() {
    # confirm <prompt> ; returns 0 when allowed to proceed
    [[ $dry_run -eq 1 || $yes -eq 1 ]] && return 0
    read -r -p "  $1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

remove_default() {
    log "scope: CLIs + audit hook + prompts + state"
    echo ""
    for cli in "${CLI_NAMES[@]}"; do
        rm_safe "$LOCAL_BIN/$cli"
    done
    rm_safe "$AUDIT_LOG"
    rm_safe "$PROMPTS_DST"
    rm_safe "$STATE_FILE"
}

remove_full() {
    log "scope (additional): config + skills + shell env"
    echo ""
    rm_safe "$JCODE_CONFIG"

    if [[ -d "$REPO/config/skills" && -d "$SKILLS_HOME" ]]; then
        for skill_dir in "$REPO/config/skills"/*/; do
            [[ -d "$skill_dir" ]] || continue
            rm_safe "$SKILLS_HOME/$(basename "$skill_dir")"
        done
    fi

    if [[ -x "$REPO/scripts/install-shell-env" ]]; then
        log "removing shell env block via install-shell-env --remove --apply"
        if [[ $dry_run -eq 1 ]]; then
            "$REPO/scripts/install-shell-env" --remove 2>&1 | sed 's/^/    /' || true
        else
            "$REPO/scripts/install-shell-env" --remove --apply
        fi
    fi
}

main() {
    echo "lazible-jcode uninstaller"
    echo ""
    echo "  config:   $JCODE_CONFIG"
    echo "  skills:   $SKILLS_HOME"
    echo "  clis:     $LOCAL_BIN"
    echo "  prompts:  $PROMPTS_DST"
    echo "  state:    $STATE_FILE"
    echo ""

    if [[ $dry_run -eq 1 ]]; then
        echo "  mode: DRY-RUN (no side effects)"
        echo ""
    fi

    if [[ $full -eq 1 ]]; then
        echo "  --full is destructive: it removes ~/.jcode/config.toml and the"
        echo "  skills this repo installed. ~/AGENTS.md and the jcode binary stay."
        echo ""
        if confirm "continue?"; then
            remove_default
            remove_full
        else
            echo "aborted."
            exit 0
        fi
    else
        echo "  This removes the helper CLIs, the audit-log hook, the orchestrator"
        echo "  prompts and state.json. Config, skills and shell env stay."
        echo ""
        echo "  Tip: --full also removes config.toml + skills + shell env."
        echo ""
        if confirm "continue?"; then
            remove_default
        else
            echo "aborted."
            exit 0
        fi
    fi

    echo ""
    echo "✓ uninstall complete"
    echo ""
    echo "Preserved (always):"
    echo "  - $HOME/.local/bin/jcode       (the binary. this repo never installed it)"
    echo "  - $HOME/AGENTS.md              (your personal global instructions)"
    echo "  - $HOME/.jcode/ambient/, state/, sessions/, logs/, goals/  (runtime state)"
    echo ""
    echo "To reinstall:"
    echo "  ./scripts/install"
}

main
