#!/usr/bin/env bash
# uninstall : reverse scripts/install
#
# Usage:
#   ./scripts/uninstall                  # remove state.json (safe, reversible)
#   ./scripts/uninstall --dry-run        # print what would be removed, do nothing
#   ./scripts/uninstall --full           # also remove config + skills (requires --yes)
#   ./scripts/uninstall --yes            # skip the confirmation prompt
#   ./scripts/uninstall --help           # show help
#
# install manages exactly three things:
#   - $HOME/.jcode/config.toml
#   - $HOME/.jcode/skills/<name>/SKILL.md for each skill in config/skills/
#   - $XDG_STATE_HOME/lazible-jcode/state.json
#
# Default (--full off) removes only state.json.
#
# --full (requires --yes) also removes:
#   - $HOME/.jcode/config.toml
#   - $HOME/.jcode/skills/<name>/ for each name in config/skills/
#
# Never removed:
#   - $HOME/.local/bin/jcode       the binary. This repo never installed it.
#   - $HOME/AGENTS.md              your personal global instructions
#   - any skill not listed in config/skills/
#   - anything else under ~/.jcode
#
# Note: config/skills/swarm-engineering is listed there, so --full removes it.
# jcode does not ship that skill, so this repo is its only source. Run
# ./scripts/install to get it back.
#
# Exit codes:
#   0  success or user declined
#   2  bad arguments
#
# Notes:
#   - any missing path is not an error, the script is idempotent
#   - this script only reverses the CURRENT install. Earlier versions of this
#     repo also installed helper CLIs to ~/.local/bin and orchestrator prompts
#     to ~/.local/share/jcode-orchestrate/. Those are not touched here because
#     this repo no longer manages them. Remove them by hand if you want them
#     gone.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

JCODE_CONFIG="$HOME/.jcode/config.toml"
SKILLS_HOME="$HOME/.jcode/skills"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lazible-jcode"
STATE_FILE="$STATE_DIR/state.json"

full=0
yes=0
dry_run=0

usage() {
    # Print the leading comment block, whatever length it happens to be.
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full)    full=1; shift ;;
        --yes)     yes=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

log() { echo "[uninstall] $*"; }

# remove a path if present, no error when absent
rm_safe() {
    if [[ -e "$1" || -L "$1" ]]; then
        log "rm $1"
        [[ $dry_run -eq 0 ]] && rm -rf "$1"
    else
        log "skip $1 (not present)"
    fi
    return 0
}

confirm() {
    [[ $dry_run -eq 1 || $yes -eq 1 ]] && return 0
    read -r -p "  $1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

remove_state() {
    rm_safe "$STATE_FILE"
}

remove_full() {
    rm_safe "$JCODE_CONFIG"

    if [[ -d "$REPO/config/skills" && -d "$SKILLS_HOME" ]]; then
        local skill_dir
        for skill_dir in "$REPO/config/skills"/*/; do
            [[ -d "$skill_dir" ]] || continue
            rm_safe "$SKILLS_HOME/$(basename "$skill_dir")"
        done
    fi
}

main() {
    echo "lazible-jcode uninstaller"
    echo ""
    echo "  config:  $JCODE_CONFIG"
    echo "  skills:  $SKILLS_HOME"
    echo "  state:   $STATE_FILE"
    echo ""
    [[ $dry_run -eq 1 ]] && { echo "  mode: DRY-RUN (no side effects)"; echo ""; }

    if [[ $full -eq 1 ]]; then
        echo "--full removes ~/.jcode/config.toml and every skill listed in"
        echo "config/skills/. The jcode binary and ~/AGENTS.md stay."
        echo ""
        if ! confirm "continue?"; then
            echo "aborted."
            exit 0
        fi
        remove_state
        remove_full
    else
        echo "This removes state.json only. Config and skills stay."
        echo ""
        echo "Tip: --full also removes config.toml and the repo's skills."
        echo ""
        if ! confirm "continue?"; then
            echo "aborted."
            exit 0
        fi
        remove_state
    fi

    echo ""
    echo "uninstall complete"
    echo ""
    echo "always preserved:"
    echo "  - \$HOME/.local/bin/jcode   (the binary, never installed here)"
    echo "  - \$HOME/AGENTS.md          (your personal global instructions)"
    echo "  - skills this repo does not own"
    echo ""
    echo "to reinstall: ./scripts/install"
}

main
