# Example `.jcode/conflict-config.yaml` for `scripts/conflict-detect.py`.
#
# Copy this file to `.jcode/conflict-config.yaml` (drop the `.example`) and
# edit the values to match your repo. The conflict-detect framework reads
# every key below; missing keys fall back to module-level defaults declared
# in `scripts/conflict-detect.py`.
#
# Schema reference (R19):
#   guardian_files         — list[str].  Files any worker touching triggers
#                                       `detect_scope_drift` = blocker. Use
#                                       for paths that only root should edit
#                                       (e.g. shared docs, install scripts).
#   severity_threshold_n   — mapping.    Escalate `suggest_serialization`
#                                       severity when N workers share a
#                                       non-lockfile file:
#                                           N <  major   -> minor
#                                           major <= N   -> major
#                                           N >= blocker -> blocker
#   prefer_side            — enum.       Default side for
#                                       `resolve_conflict_hunks` when the
#                                       caller does not pass one explicitly.
#                                       One of: worker | main | newer |
#                                       intersection.
#   cleanup_patterns       — list[str].  Glob patterns whose matches are
#                                       deleted (not staged) by
#                                       `cleanup_worktree_artifacts`. Use
#                                       for build residue and backups.
#
# Legacy keys (read by R14/R17 detectors) are also honoured:
#   lockfile_files         — list[str].  Extra lockfile/migration paths
#                                       beyond the framework defaults.
#   ignored_paths          — list[str].  fnmatch globs; matching scope
#                                       entries are silently dropped.
#   heartbeat_ttl_seconds  — int.       Stale-heartbeat threshold used by
#                                       `detect_heartbeat_stale`.

# Files only the root session should touch. Workers touching any of these
# without explicit scope declaration get a blocker from detect_scope_drift.
guardian_files:
  - AGENTS.md
  - README.md
  - .jcode/prompt-overlay.md
  - swarm/swarm-prompt.md
  - install.sh

# Escalation thresholds for `suggest_serialization`. R19 spec defaults:
#   major: 4   (5+ workers sharing a file -> major)
#   blocker: 6 (6+ workers sharing a file -> blocker)
severity_threshold_n:
  major: 4
  blocker: 6

# Default side for `resolve_conflict_hunks` when the caller omits it.
# `intersection` = git merge --union style (keep both sides' hunks).
prefer_side: newer

# Patterns whose matches are deleted (not staged) by cleanup_worktree_artifacts.
# Directories end with `/`; globs use fnmatch semantics (`**` collapses to `*`).
cleanup_patterns:
  - __pycache__/
  - "*.bak.*"
  - "*.pyc"
  - "*.tmp"

# ----- Legacy keys (optional) -----

# Extra lockfile patterns beyond the framework defaults (Cargo.lock, etc.).
# lockfile_files:
#   - dotnet/project.assets.json

# Paths to silently drop from scope overlap detection (fnmatch globs).
# ignored_paths:
#   - "**/__pycache__/**"
#   - "**/*.bak.*"

# Override heartbeat staleness TTL (default 8h).
# heartbeat_ttl_seconds: 28800
