#!/usr/bin/env bash
# uninstall : reverse scripts/install
#
# Usage:
#   ./scripts/uninstall                  # remove state.json (safe, reversible)
#   ./scripts/uninstall --dry-run        # print what would be removed, do nothing
#   ./scripts/uninstall --full           # also remove config + skills (requires --yes)
#   ./scripts/uninstall --yes            # skip the confirmation prompt
#   ./scripts/uninstall --help           # show help
#
# install manages exactly three things:
#   - $HOME/.jcode/config.toml
#   - $HOME/.jcode/skills/<name>/SKILL.md for each skill in config/skills/
#   - $XDG_STATE_HOME/lazible-jcode/state.json
#
# Default (--full off) removes only state.json.
#
# --full (requires --yes) also removes:
#   - $HOME/.jcode/config.toml
#   - $HOME/.jcode/skills/<name>/ for each name in config/skills/
#
# Never removed:
#   - $HOME/.local/bin/jcode       the binary. This repo never installed it.
#   - $HOME/AGENTS.md              your personal global instructions
#   - any skill not listed in config/skills/
#   - anything else under ~/.jcode
#
# Note: config/skills/swarm-engineering is listed there, so --full removes it.
# jcode does not ship that skill, so this repo is its only source. Run
# ./scripts/install to get it back.
#
# Exit codes:
#   0  success or user declined
#   2  bad arguments
#
# Notes:
#   - any missing path is not an error, the script is idempotent
#   - this script only reverses the CURRENT install: config.toml, the repo's
#     own skills, and state.json. The legacy helper CLIs and orchestrator
#     prompts from earlier versions are long gone from the machine and are
#     not referenced here.

set -euo pipefail

# shellcheck source=scripts/common.sh
. "$(dirname "$0")/common.sh"

full=0
yes=0
dry_run=0

# The live path of every skill this repo owns.
#
# The installer builds the same list, so the two scripts agree on exactly
# which skills are in scope. Without that agreement, a skill the installer
# would write could be one the uninstaller never checks, and the repo
# boundary would hold for one script and not the other.
skill_targets=()
for skill_src in "$REPO"/config/skills/*/; do
    skill_src="${skill_src%/}"
    [[ -f "$skill_src/SKILL.md" ]] || continue
    skill_targets+=("$SKILLS_HOME/$(basename "$skill_src")")
done

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full)    full=1; shift ;;
        --yes)     yes=1; shift ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

# remove a path if present, no error when absent
rm_safe() {
    local p="$1"

    # Never delete from inside the repo. A symlinked ~/.jcode or skills
    # directory would otherwise redirect "rm -rf" onto the repo's own
    # config and skill files, which is data loss, not an uninstall.
    #
    # The REMOVAL guard is the right one here, not the plain one. rm
    # removes the directory ENTRY and does not follow a final symlink, so
    # the question is not "where does this path point" but "where does
    # this entry live". The plain guard resolves the final component and
    # would say "outside the repo" for a path whose entry is inside it.
    guard_outside_repo_for_removal "$p"

    if [[ -e "$p" || -L "$p" ]]; then
        if [[ $dry_run -eq 1 ]]; then
            log "would remove: $p"
        else
            log "rm $p"
            rm -rf "$p"
        fi
    else
        log "skip $p (not present)"
    fi
    return 0
}

confirm() {
    [[ $dry_run -eq 1 || $yes -eq 1 ]] && return 0
    read -r -p "  $1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

remove_state() {
    rm_safe "$STATE_FILE"
}

remove_full() {
    rm_safe "$JCODE_CONFIG"

    local skill_target
    for skill_target in "${skill_targets[@]}"; do
        rm_safe "$skill_target"
    done
}

# Every path this run would touch, checked before anything is removed.
#
# The check has to be up front rather than inside rm_safe. Otherwise a
# refusal halfway through would leave the uninstall half done: the state
# file already gone, the config still there.
#
# The removal semantics are what matter here. rm removes the directory
# entry and does not follow a final symlink, so the path that matters is
# the resolved PARENT plus the literal last component. A path can point
# outside the repo and still be an entry that lives inside it.
guard_repo_boundary() {
    local p
    p=("$STATE_FILE" "$JCODE_CONFIG")

    if [[ $full -eq 1 ]]; then
        p+=("${skill_targets[@]}")
    fi

    guard_outside_repo_for_removal "${p[@]}"
}

main() {
    echo "lazible-jcode uninstaller"
    echo ""
    echo "  config:  $JCODE_CONFIG"
    echo "  skills:  $SKILLS_HOME"
    echo "  state:   $STATE_FILE"
    echo ""
    [[ $dry_run -eq 1 ]] && { echo "  mode: DRY-RUN (no side effects)"; echo ""; }

    # Checked before the confirmation, so the refusal is the same whether
    # or not the user is asked.
    guard_repo_boundary

    if [[ $full -eq 1 ]]; then
        echo "--full removes ~/.jcode/config.toml and every skill listed in"
        echo "config/skills/. The jcode binary and ~/AGENTS.md stay."
        echo ""
        if ! confirm "continue?"; then
            echo "aborted."
            exit 0
        fi
        remove_state
        remove_full
    else
        echo "This removes state.json only. Config and skills stay."
        echo ""
        echo "Tip: --full also removes config.toml and the repo's skills."
        echo ""
        if ! confirm "continue?"; then
            echo "aborted."
            exit 0
        fi
        remove_state
    fi

    echo ""
    if [[ $dry_run -eq 1 ]]; then
        echo "dry-run complete. nothing was removed. re-run without --dry-run to actually uninstall."
    else
        echo "uninstall complete"
    fi
    echo ""
    echo "always preserved:"
    echo "  - \$HOME/.local/bin/jcode   (the binary, never installed here)"
    echo "  - \$HOME/AGENTS.md          (your personal global instructions)"
    echo "  - skills this repo does not own"
    echo ""
    echo "to reinstall: ./scripts/install"
}

main
