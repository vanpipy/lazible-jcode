#!/usr/bin/env python3
"""rule-inventory : extract the normative claims from a prompt tier.

    ./rule-inventory.py <file> [--before <ref>]

Prints one rule per line: the sentence, its kind, and its normalized text.
The normalized text is what a before/after comparison matches on.

The point is to answer a question that a byte count cannot: did the
compression drop a rule, or did it only reword one? A rule is a sentence
that carries an obligation. Imperative openings, modal verbs, and the
deontic words the policy tiers use ("must", "never", "do not", "is not",
"has to", "only when") mark one.

Comparison mode reads the "before" text from a git ref and the "after" text
from the working tree, then reports which rules are gone.

    ./rule-inventory.py config/swarm-prompt.md --before HEAD
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys

# The deontic markers that make a sentence an obligation rather than a
# description. A description ("The overlay is a system-prompt layer") is
# context. An obligation ("The overlay must be a system-prompt layer") is
# policy, and a policy that disappears is what this tool is looking for.
DEONTIC = re.compile(
    r"\b(must|must not|mustn't|never|do not|don't|shall|should|should not|"
    r"has to|have to|had to|need to|needs to|cannot|can't|may not|"
    r"is not|are not|does not|do not|did not|only when|only if|"
    r"is required|are required|is prohibited|forbids?|forbidden|"
    r"rather than|instead of)\b",
    re.IGNORECASE,
)

# An imperative opening: the sentence starts with a bare verb.
IMPERATIVE = re.compile(
    r"^(spawn|do|don't|avoid|use|pass|give|write|report|keep|stop|ask|"
    r"review|run|check|confirm|name|list|watch|message|send|state|read|"
    r"treat|record|integrate|assign|respect|return|include|hold|leave|"
    r"prefer|bind|bound|never|always|start|begin|end|set|put|make|"
    r"remember|note|verify|measure|measure|inspect|extract|assert)\b",
    re.IGNORECASE,
)

# A heading is not a rule.
HEADING = re.compile(r"^#{1,6}\s")


def sentences(text: str) -> list[str]:
    """Split into sentences, keeping bullets and list items whole."""
    out: list[str] = []
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("<!--") or line.startswith("-->"):
            continue
        if HEADING.match(raw_line):
            continue
        # A bullet is one claim even when it has several sentences.
        if line.startswith(("- ", "* ", "1. ", "2. ", "3. ")):
            line = re.sub(r"^([-*]|\d+\.)\s+", "", line)
            out.append(line)
            continue
        for part in re.split(r"(?<=[.!?])\s+", line):
            part = part.strip()
            if part:
                out.append(part)
    return out


def classify(sentence: str) -> str | None:
    """The kind of rule this sentence is, or None if it is not a rule."""
    if DEONTIC.search(sentence):
        return "deontic"
    if IMPERATIVE.match(sentence):
        return "imperative"
    return None


def stem(token: str) -> str:
    """The root of a word, roughly.

    A rewrite changes the grammar around a claim more often than it changes
    the claim's words. "must inspect" becomes "inspects", "reports" becomes
    "reported". Without stemming, the one word that carries the claim is
    the one that looks different, and the matcher misses a rule that
    survived.

    The rules here are crude on purpose. They are enough to join the forms
    that appear in these files and short enough that they cannot join two
    different words into one.
    """
    if len(token) > 4 and token.endswith("ies"):
        return token[:-3] + "y"
    if len(token) > 4 and token.endswith("sses"):
        return token[:-2]
    if len(token) > 3 and token.endswith("s") and not token.endswith("ss"):
        return token[:-1]
    if len(token) > 5 and token.endswith("ing"):
        return token[:-3]
    if len(token) > 4 and token.endswith("ed"):
        return token[:-2]
    return token


def normalize(sentence: str) -> str:
    """The sentence reduced to the words that carry its meaning.

    Stop words, punctuation and the markdown emphasis are dropped, and each
    word is stemmed, so a rewording that kept the obligation matches, and
    one that dropped it does not.
    """
    s = sentence.lower()
    s = re.sub(r"[`*_\[\]]", " ", s)
    s = re.sub(r"[^a-z0-9\s]", " ", s)
    stop = {
        "a", "an", "the", "and", "or", "but", "if", "then", "so", "than",
        "that", "this", "these", "those", "it", "its", "is", "are", "was",
        "were", "be", "been", "being", "to", "of", "in", "on", "at", "by",
        "for", "with", "as", "from", "not", "no", "do", "does", "did",
        "you", "your", "it", "its", "when", "while", "there", "here",
        "one", "any", "all", "each", "every", "only", "also", "same",
        "own", "up", "out", "into", "over", "than", "very", "just",
    }
    words = [stem(w) for w in s.split() if w and w not in stop]
    return " ".join(words)


def build_corpus(norms: set[str]) -> dict[str, int]:
    """How often each term appears across the corpus."""
    corpus: dict[str, int] = {}
    for norm in norms:
        for token in set(norm.split()):
            corpus[token] = corpus.get(token, 0) + 1
    return corpus


def distinctive_terms(rule: str, corpus: dict[str, int]) -> list[str]:
    """The terms of a rule that carry its meaning.

    A rule is identified by the words that are unusual in the corpus. "The
    coordinator reviews the diff" and "A reviewer inspects the actual diff"
    share "review" and "diff", which are the words that carry the claim. The
    words they do not share ("coordinator" against "reviewer") are the parts
    that were reworded.

    The rarity is measured across the whole corpus, so a term that appears in
    every rule carries no information and a term that appears in one rule
    carries all of it.
    """
    tokens = rule.split()
    if not tokens:
        return []
    scored = sorted((corpus.get(token, 0), token) for token in tokens)
    # The rarest third of the terms is the identifying set. A rule of three
    # words keeps its rarest one, which is enough to find a reworded
    # counterpart and not enough to match an unrelated rule.
    keep = max(1, len(scored) // 3)
    return [token for _, token in scored[:keep]]


def match_kept(
    before_rows: list[tuple[str, str, str]],
    after_rows: list[tuple[str, str, str]],
    after_text: str,
) -> tuple[list[str], list[tuple[str, str]], list[str]]:
    """Pair the before and after rules that are the same rule.

    Returns (kept, gone, added). A before rule is kept when the rewritten
    file still carries its distinctive terms. A before rule whose terms are
    absent is gone. An after rule that matched nothing is added.

    The test is "does the rewritten file still use this rule's rare words",
    not "is there one sentence that contains all of them". A compression
    pass merges sentences and splits them, so the words that carry a claim
    can end up spread across two sentences. Requiring one sentence to hold
    all of them reports a rule as gone when it is still there.

    The search runs over the whole rewritten file, not just its rules. A
    claim often survives as a plain sentence that no longer reads as an
    obligation, because the deontic marker was the part that got cut. "Do
    not pad the report to look thorough" can become "It does not pad the
    report", which is a description, and the inventory would not have
    collected it as a rule at all.

    The terms that carry a claim are the rare ones. "must" and "the" appear
    in half the rules and identify nothing. "diff", "handover" and
    "sufficiency" each appear in a handful, and they are the words that say
    what the rule is about.

    A rule needs most of its terms, not all of them, because a rewrite may
    replace a term with a synonym that the corpus did not have.
    """
    before_norms = {n for _, n, _ in before_rows}
    corpus = build_corpus(before_norms)
    # Every word in the rewritten file, not only the words in its rules.
    after_terms = set(stem(w) for w in re.findall(r"[a-z0-9]+", after_text.lower()))

    kept: list[str] = []
    gone: list[tuple[str, str]] = []
    for kind, norm, raw in before_rows:
        terms = distinctive_terms(norm, corpus)
        if not terms:
            continue
        present = [t for t in terms if t in after_terms]
        # Most of the distinctive terms have to survive. For a rule with one
        # distinctive term, that term has to survive.
        needed = 1 if len(terms) == 1 else (len(terms) + 1) // 2
        if len(present) >= needed:
            kept.append(raw)
        else:
            gone.append((raw, ", ".join(terms)))

    claimed_after: set[str] = set()
    for kind, norm, raw in after_rows:
        for bnorm in before_norms:
            terms = distinctive_terms(bnorm, corpus)
            if terms and set(terms) & set(norm.split()):
                claimed_after.add(norm)
                break

    added = [raw for _, norm, raw in after_rows if norm not in claimed_after]
    return kept, gone, added


def read_before(path: str, ref: str) -> str:
    out = subprocess.run(
        ["git", "show", f"{ref}:{path}"],
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        sys.stderr.write(f"cannot read {ref}:{path}\n")
        sys.exit(2)
    return out.stdout


def inventory(text: str) -> list[tuple[str, str, str]]:
    rows: list[tuple[str, str, str]] = []
    for s in sentences(text):
        kind = classify(s)
        if kind is None:
            continue
        rows.append((kind, normalize(s), s))
    return rows


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="rule-inventory")
    ap.add_argument("file")
    ap.add_argument("--before", help="git ref to compare against")
    ap.add_argument("--show", action="store_true", help="print every rule")
    args = ap.parse_args(argv)

    after_text = open(args.file, encoding="utf-8").read()
    after = inventory(after_text)

    if not args.before:
        for kind, norm, raw in after:
            if args.show:
                print(f"[{kind}] {raw}")
            else:
                print(f"[{kind}] {norm}")
        print(f"# {len(after)} rules in {args.file}", file=sys.stderr)
        return 0

    before_text = read_before(args.file, args.before)
    before = inventory(before_text)
    before_norms = {n for _, n, _ in before}
    after_norms = {n for _, n, _ in after}

    # A rule that is gone. The before set is paired against the after set by
    # content overlap, so a reworded rule counts as kept, and only a rule
    # whose content really did not survive is reported as gone.
    kept, gone, added = match_kept(before, after, after_text)

    print(f"# {args.file}: {len(before)} rules before, {len(after)} after")
    print(
        f"# {len(kept)} kept, {len(gone)} gone, {len(added)} added"
        f" (distinctive-term matching)"
    )
    print()
    print("## gone")
    for raw, terms in gone:
        print(f"  - {raw}")
        print(f"      (distinctive terms: {terms})")
    print()
    print("## added")
    for raw in sorted(added):
        print(f"  + {raw}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
