#!/usr/bin/env python3
"""report which HEAD rules each section of a candidate must keep alive.

Usage:
    report.py <candidate.md> [--baseline HEAD]

Prints, per section of the candidate, the content words that HEAD rules
whose distinctive terms live in that section depend on. A compression pass
that drops one of those words loses the rule.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import pathlib
import re
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
RI = REPO / "scripts" / "rule-inventory"

loader = importlib.machinery.SourceFileLoader("ri", str(RI))
spec = importlib.util.spec_from_loader("ri", loader)
ri = importlib.util.module_from_spec(spec)
loader.exec_module(ri)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("candidate")
    ap.add_argument("--baseline", default="HEAD")
    args = ap.parse_args()

    base_text = subprocess.run(
        ["git", "show", f"{args.baseline}:config/skills/swarm-engineering/SKILL.md"],
        capture_output=True, text=True, check=True, cwd=REPO,
    ).stdout
    cand_text = pathlib.Path(args.candidate).read_text()

    base_rows = ri.inventory(base_text)
    corpus = ri.build_corpus({n for _, n, _ in base_rows})
    after_terms = set(ri.stem(w) for w in re.findall(r"[a-z0-9]+", cand_text.lower()))

    # Split the candidate into sections.
    parts = re.split(r"(?m)^(#{1,4} .+)$", cand_text)
    sections = []
    cur_head = "(preamble)"
    cur_body = parts[0]
    for i in range(1, len(parts), 2):
        sections.append((cur_head, cur_body))
        cur_head = parts[i]
        cur_body = parts[i + 1]
    sections.append((cur_head, cur_body))

    # Which section holds which content word.
    word_section = {}
    for head, body in sections:
        terms = set(ri.stem(w) for w in re.findall(r"[a-z0-9]+", body.lower()))
        for t in terms:
            word_section.setdefault(t, head)

    print(f"candidate {len(cand_text.encode())} bytes, {len(sections)} sections")
    print()
    lost_total = 0
    for kind, norm, raw in base_rows:
        words = ri.content_words(norm)
        if not words:
            continue
        share = ri.coverage(norm, after_terms)
        if share < 0.5:
            lost_total += 1
            missing = [w for w in words if w not in after_terms]
            print(f"GONE  {share:.0%}  {raw[:70]}")
            print(f"      missing: {' '.join(missing)}")
            continue
        rarest = sorted(words, key=lambda w: (corpus.get(w, 0), w))[0]
        if rarest not in after_terms:
            lost_total += 1
            print(f"RISK  {share:.0%}  {raw[:70]}")
            print(f"      lost rare word: {rarest}")
    print()
    print(f"problems: {lost_total}")

    # Per-section word budget: the words only this section supplies.
    print()
    print("=== section -> words that only this section carries ===")
    all_sections = [h for h, _ in sections]
    for head, body in sections:
        terms = set(ri.stem(w) for w in re.findall(r"[a-z0-9]+", body.lower()))
        exclusive = sorted(t for t in terms if t not in {w for h2, b2 in sections if h2 != head
                                                       for w in set(ri.stem(x) for x in re.findall(r"[a-z0-9]+", b2.lower()))})
        if exclusive:
            print(f"{head}: {' '.join(exclusive)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
