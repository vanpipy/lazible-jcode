#!/usr/bin/env python3
"""inject-defect : prove the gate catches the defects it claims to catch.

    ./scripts/inject-defect [--keep]

A gate that passes tells you nothing until you know it fails when it
should. This injects one defect at a time into the three prompt tiers and
checks that each one is caught, both by scripts/prompt-contract and by
scripts/test.

The defects are the ones a compression pass is most likely to introduce
by accident:

  dropped-string    A protected string is removed or reworded.
  changed-heading   A protected heading's text is altered.
  new-section       A "section 7A" reference appears in the overlay.
  punctuated-heading A heading gains trailing punctuation.
  long-line         A line grows past the width the file uses.
  trailing-space    A line gains trailing whitespace.

Every file is restored before the run and again after it, so a run
leaves the working tree as it found it. With --keep, the injected state
is left in place for inspection.

Exit status is 0 when every defect was caught by every checker that
claims to catch it.
"""
from __future__ import annotations

import argparse
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

REPO = pathlib.Path(__file__).resolve().parent.parent

OVERLAY = REPO / "config" / "prompt-overlay.md"
SKILL = REPO / "config" / "skills" / "swarm-engineering" / "SKILL.md"
SWARM = REPO / "config" / "swarm-prompt.md"

# A defect is (name, file, mutation, the checker that must catch it).
#
# "contract" means scripts/prompt-contract check must fail.
# "test" means scripts/test must fail.
DEFECTS = [
    (
        "dropped-string",
        SKILL,
        lambda t: t.replace("See section 13.", "See section 14.", 1),
        ("contract", "test"),
    ),
    (
        "dropped-string",
        SWARM,
        lambda t: t.replace(
            "criteria are also the lane's verification target set",
            "criteria are also the lane's target set",
            1,
        ),
        ("contract", "test"),
    ),
    (
        "changed-heading",
        SKILL,
        lambda t: t.replace(
            "## 13. Requirement Handover",
            "## 13. Requirement Handover Plan",
            1,
        ),
        ("contract", "test"),
    ),
    (
        "new-section",
        OVERLAY,
        lambda t: t.replace(
            "## 7. Engineering Integrity",
            "## 7. Engineering Integrity. See section 7A for the rules.",
            1,
        ),
        ("contract", "test"),
    ),
    (
        "punctuated-heading",
        OVERLAY,
        lambda t: t.replace(
            "## 3. Understand the Objective",
            "## 3. Understand the Objective.",
            1,
        ),
        ("contract", "test"),
    ),
    (
        "long-line",
        OVERLAY,
        lambda t: t.replace(
            "## 3. Understand the Objective",
            "## 3. Understand the Objective "
            + "and the constraints that bound it",
            1,
        ),
        ("test",),
    ),
    (
        "trailing-space",
        OVERLAY,
        lambda t: t.replace(
            "## 3. Understand the Objective",
            "## 3. Understand the Objective   ",
            1,
        ),
        ("test",),
    ),
]


def run(cmd: list[str]) -> tuple[int, str]:
    out = subprocess.run(cmd, cwd=REPO, capture_output=True, text=True)
    return out.returncode, out.stdout + out.stderr


def check_catches(name: str, file: pathlib.Path, mutate, checkers) -> tuple[bool, str]:
    """Inject the defect, run the checkers, restore, report."""
    original = file.read_text(encoding="utf-8")
    mutated = mutate(original)
    if mutated == original:
        return False, "the mutation did not apply, the defect was not injected"

    file.write_text(mutated, encoding="utf-8")
    try:
        results = []
        for checker in checkers:
            if checker == "contract":
                code, _ = run([str(REPO / "scripts" / "prompt-contract"), "check"])
            elif checker == "test":
                code, _ = run([str(REPO / "scripts" / "test")])
            else:
                code, _ = run([str(REPO / "scripts" / "prompt-verify"), "HEAD"])
            results.append((checker, code != 0))
        return all(ok for _, ok in results), ", ".join(
            f"{c} {'caught' if ok else 'MISSED'}" for c, ok in results
        )
    finally:
        file.write_text(original, encoding="utf-8")


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="inject-defect")
    ap.add_argument("--keep", action="store_true",
                    help="leave the last injected defect in place")
    args = ap.parse_args(argv[1:])

    # A snapshot of every file a defect touches, so the run can restore
    # all of them even if it is interrupted.
    backup = pathlib.Path(tempfile.mkdtemp(prefix="inject-defect-"))
    for f in (OVERLAY, SKILL, SWARM):
        shutil.copy2(f, backup / f.name)

    print(f"=== every injected defect is caught ===")
    failures = 0
    for name, file, mutate, checkers in DEFECTS:
        caught, detail = check_catches(name, file, mutate, checkers)
        status = "ok  " if caught else "FAIL"
        if not caught:
            failures += 1
        print(f"  {status} {name} in {file.relative_to(REPO)}: {detail}")

    if args.keep:
        print("\n--keep was given, the last defect is still in place")
    else:
        for f in (OVERLAY, SKILL, SWARM):
            shutil.copy2(backup / f.name, f)
        shutil.rmtree(backup, ignore_errors=True)
        print("\nthe working tree is restored")

    print()
    if failures:
        print(f"inject-defect: {failures} defect(s) were not caught")
        return 1
    print("inject-defect: every injected defect was caught")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
