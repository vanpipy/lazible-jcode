#!/usr/bin/env bash
# install : wire this config repo into ~/.jcode
#
# Usage:
#   ./scripts/install                 # install config (default)
#   ./scripts/install --dry-run       # show what would happen, no side effects
#   ./scripts/install --help          # show this header
#
# This repo is a CONFIG repo. It installs configuration, skills, policies and
# helper CLIs. It does not build, patch or distribute the jcode binary. Install
# jcode separately (see README.md).
#
# What gets installed:
#   1. preflight  : deps (bash / python3 / git), path writability, no symlinked config
#   2. config     : config/config.toml                 -> ~/.jcode/config.toml
#   3. skills     : config/skills/*/SKILL.md           -> ~/.jcode/skills/*/
#   4. shell env  : JCODE_OPENROUTER_MODEL             -> ~/.zshrc + ~/.bashrc
#   5. audit hook : scripts/jcode-audit-log            -> ~/.local/bin/
#   6. CLIs       : config/bin/jcode-{goal,l2-check,tool-policy,orchestrate}
#                                                          -> ~/.local/bin/
#   7. prompts    : config/share/jcode-orchestrate/prompts/*.md
#                                                          -> ~/.local/share/jcode-orchestrate/prompts/
#   8. AGENTS.md  : config/templates/AGENTS.md          -> ~/AGENTS.md  (only if missing)
#   9. verify     : 12 checks
#  10. state      : ~/.local/state/lazible-jcode/state.json
#
# Exit codes:
#   0  success
#   1  preflight failed
#   6  verify failed
#
# Design constraints:
#   - The repo is the source of truth for everything it owns. Skills, prompts
#     and CLIs are rewritten on every install. If you edited a copy under
#     ~/.jcode/skills by hand, pull it back first:
#       ./scripts/sync-skills --from-home --apply
#   - ~/AGENTS.md is the one exception: it is only written when absent, so your
#     personal instructions are never clobbered.
#   - ~/.jcode/config.toml must not be a symlink (exit 1). A symlink would let
#     a write flow back into the repo base.
#   - Nothing outside ~/.jcode, ~/.local/bin, ~/.local/share and ~/.zshrc or
#     ~/.bashrc is touched.

set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"

JCODE_CONFIG="$HOME/.jcode/config.toml"
SKILLS_HOME="$HOME/.jcode/skills"
LOCAL_BIN="$HOME/.local/bin"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/lazible-jcode"
STATE_FILE="$STATE_DIR/state.json"
PROMPTS_SRC="$REPO/config/share/jcode-orchestrate/prompts"
PROMPTS_DST="$HOME/.local/share/jcode-orchestrate/prompts"

CLI_NAMES=(jcode-goal jcode-l2-check jcode-tool-policy jcode-orchestrate)

dry_run=0

usage() {
    sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

log()  { echo "[install] $*"; }
warn() { echo "[install] WARN: $*" >&2; }
err()  { echo "[install] ERR: $*" >&2; }
section() { echo ""; echo "=== $* ==="; }

run() {
    if [[ $dry_run -eq 1 ]]; then
        echo "  would run: $*"
    else
        "$@"
    fi
}

copy_file() {
    # copy_file <src> <dst> <mode>
    local src="$1" dst="$2" mode="$3"
    if [[ $dry_run -eq 1 ]]; then
        echo "  would install: $src -> $dst"
        return 0
    fi
    mkdir -p "$(dirname "$dst")"
    install -m "$mode" "$src" "$dst"
}

# ---------------------------------------------------------------------------
# Phase 1: preflight
# ---------------------------------------------------------------------------

phase_preflight() {
    section "phase 1: preflight"

    local missing=()
    command -v bash    >/dev/null || missing+=("bash")
    command -v python3 >/dev/null || missing+=("python3")
    command -v git     >/dev/null || missing+=("git")
    if [[ ${#missing[@]} -gt 0 ]]; then
        err "missing deps: ${missing[*]}"
        exit 1
    fi

    for d in "$HOME/.jcode" "$LOCAL_BIN" "$STATE_DIR"; do
        if [[ ! -d "$d" ]]; then
            run mkdir -p "$d"
        fi
        [[ -w "$d" ]] || { err "not writable: $d"; exit 1; }
    done

    # A symlinked config would let a write land in the repo base.
    if [[ -L "$JCODE_CONFIG" ]]; then
        err "$JCODE_CONFIG is a symlink -> $(readlink "$JCODE_CONFIG")"
        err "scripts refuse to write through it. Fix:"
        err "  rm $JCODE_CONFIG && cp $REPO/config/config.toml $JCODE_CONFIG"
        exit 1
    fi

    log "preflight ok"
}

# ---------------------------------------------------------------------------
# Phase 2: config
# ---------------------------------------------------------------------------

phase_config() {
    section "phase 2: config"
    copy_file "$REPO/config/config.toml" "$JCODE_CONFIG" 0644
    log "config installed: $JCODE_CONFIG"
}

# ---------------------------------------------------------------------------
# Phase 3: skills
#
# Repo-owned skills are authoritative. They are rewritten every install so a
# deleted or stale copy under ~/.jcode/skills cannot silently drift.
# ---------------------------------------------------------------------------

phase_skills() {
    section "phase 3: skills"
    local n=0
    for src in "$REPO"/config/skills/*/; do
        src="${src%/}"
        [[ -d "$src" ]] || continue
        [[ -f "$src/SKILL.md" ]] || continue
        local name
        name="$(basename "$src")"
        copy_file "$src/SKILL.md" "$SKILLS_HOME/$name/SKILL.md" 0644
        n=$((n+1))
    done
    log "skills installed: $n"
}

# ---------------------------------------------------------------------------
# Phase 4: shell env
# ---------------------------------------------------------------------------

phase_shell_env() {
    section "phase 4: shell env"
    run "$REPO/scripts/install-shell-env" --apply
    log "shell env installed (JCODE_OPENROUTER_MODEL)"
}

# ---------------------------------------------------------------------------
# Phase 5: audit hook
# ---------------------------------------------------------------------------

phase_audit_hook() {
    section "phase 5: audit hook"
    copy_file "$REPO/scripts/jcode-audit-log" "$LOCAL_BIN/jcode-audit-log" 0755
    log "audit log hook installed: $LOCAL_BIN/jcode-audit-log"
}

# ---------------------------------------------------------------------------
# Phase 6: CLIs
# ---------------------------------------------------------------------------

phase_clis() {
    section "phase 6: CLIs"
    for cli in "${CLI_NAMES[@]}"; do
        copy_file "$REPO/config/bin/$cli" "$LOCAL_BIN/$cli" 0755
        log "CLI installed: $LOCAL_BIN/$cli"
    done
}

# ---------------------------------------------------------------------------
# Phase 7: orchestrator prompts
# ---------------------------------------------------------------------------

phase_prompts() {
    section "phase 7: orchestrator prompts"
    for f in "$PROMPTS_SRC"/*.md; do
        [[ -f "$f" ]] || continue
        copy_file "$f" "$PROMPTS_DST/$(basename "$f")" 0644
    done
    log "orchestrator prompts installed: $PROMPTS_DST"
}

# ---------------------------------------------------------------------------
# Phase 8: ~/AGENTS.md
#
# Only written when absent. The user's personal global instructions win.
# ---------------------------------------------------------------------------

phase_agents_md() {
    section "phase 8: ~/AGENTS.md"
    if [[ -f "$HOME/AGENTS.md" ]]; then
        log "\$HOME/AGENTS.md already exists (skipped; install never overwrites it)"
    else
        copy_file "$REPO/config/templates/AGENTS.md" "$HOME/AGENTS.md" 0644
        log "\$HOME/AGENTS.md installed from template (customize freely)"
    fi
}

# ---------------------------------------------------------------------------
# Phase 9: verify
# ---------------------------------------------------------------------------

phase_verify() {
    section "phase 9: verify"

    if [[ $dry_run -eq 1 ]]; then
        echo "  would run 12 checks (skipped in --dry-run)"
        return 0
    fi

    local ok=0 fail=0

    # Checks must survive individual failures so the full report prints.
    local saved_opts
    saved_opts="$-"
    set +e +o pipefail

    check() {
        if [[ $? -eq 0 ]]; then
            ok=$((ok+1)); echo "  ✓ $1"
        else
            fail=$((fail+1)); echo "  ✗ $1"
        fi
    }

    python3 -c "import tomllib,sys; tomllib.load(open('$JCODE_CONFIG','rb'))"
    check "$JCODE_CONFIG parses"

    [[ ! -L "$JCODE_CONFIG" ]]
    check "$JCODE_CONFIG is a regular file"

    diff -q "$REPO/config/config.toml" "$JCODE_CONFIG" >/dev/null 2>&1
    check "live config matches repo config/config.toml"

    grep -q "enabled = true" "$JCODE_CONFIG"
    check "ambient enabled"

    [[ -f "$SKILLS_HOME/goal/SKILL.md" ]]
    check "goal skill installed"

    [[ -f "$SKILLS_HOME/orchestrator/SKILL.md" ]]
    check "orchestrator skill installed"

    [[ -f "$SKILLS_HOME/long-task-discipline/SKILL.md" ]]
    check "long-task-discipline skill installed"

    [[ -x "$LOCAL_BIN/jcode-goal" ]]
    check "jcode-goal CLI installed"

    [[ -x "$LOCAL_BIN/jcode-l2-check" ]]
    check "jcode-l2-check CLI installed"

    [[ -x "$LOCAL_BIN/jcode-tool-policy" ]]
    check "jcode-tool-policy pre_tool gate installed"

    [[ -x "$LOCAL_BIN/jcode-orchestrate" ]]
    check "jcode-orchestrate CLI installed"

    grep -q "JCODE_OPENROUTER_MODEL" "$HOME/.zshrc" "$HOME/.bashrc" 2>/dev/null
    check "shell env installed (JCODE_OPENROUTER_MODEL)"

    set -${saved_opts}

    echo ""
    echo "verify: $ok passed, $fail failed"
    [[ $fail -eq 0 ]] || exit 6
}

# ---------------------------------------------------------------------------
# Phase 10: state + summary
# ---------------------------------------------------------------------------

phase_finalize() {
    section "phase 10: state + summary"

    if [[ $dry_run -eq 1 ]]; then
        echo "  would write: $STATE_FILE"
        echo ""
        echo "dry-run complete. re-run without --dry-run to actually install."
        exit 0
    fi

    mkdir -p "$STATE_DIR"

    python3 - "$STATE_FILE" "$REPO" "${CLI_NAMES[@]}" <<'PY'
import hashlib, json, os, sys, datetime
state_path, repo = sys.argv[1], sys.argv[2]
clis = sys.argv[3:]

cfg = os.path.join(repo, "config", "config.toml")
with open(cfg, "rb") as f:
    digest = hashlib.sha256(f.read()).hexdigest()

data = {
    "config_sha256": digest,
    "installed_at": datetime.datetime.now().isoformat(timespec="seconds"),
    "clis": clis,
}
with open(state_path, "w") as f:
    json.dump(data, f, indent=2, sort_keys=True)
    f.write("\n")
PY
    log "state written: $STATE_FILE"

    echo ""
    echo "✓ install complete"
    echo ""
    echo "  config:   $JCODE_CONFIG"
    echo "  skills:   $SKILLS_HOME"
    echo "  clis:     $LOCAL_BIN/{jcode-goal,jcode-l2-check,jcode-tool-policy,jcode-orchestrate}"
    echo "  prompts:  $PROMPTS_DST"
    echo "  state:    $STATE_FILE"
    echo ""
    echo "Next steps:"
    echo "  1. New shell, or: source ~/.zshrc"
    echo "  2. Readiness check: jcode-l2-check"
    echo "  3. Start a goal:    cd <your-project> && /goal \"<title>\" --priority high"
    echo "  4. Advance a cycle: cd <your-project> && /orchestrate loop 10"
    echo ""
    echo "To reinstall after editing this repo: ./scripts/install"
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

main() {
    echo "lazible-jcode installer (config only)"
    echo ""
    echo "  config:  $JCODE_CONFIG"
    echo "  skills:  $SKILLS_HOME"
    echo "  clis:    $LOCAL_BIN"
    echo "  state:   $STATE_FILE"
    echo ""
    [[ $dry_run -eq 1 ]] && echo "  mode: DRY-RUN (no side effects)"
    echo ""

    phase_preflight
    phase_config
    phase_skills
    phase_shell_env
    phase_audit_hook
    phase_clis
    phase_prompts
    phase_agents_md
    phase_verify
    phase_finalize
}

main
