# secrets / live config (should never reach git)
# Allow the sanitized config.toml snapshot + example files
config/*
!config/*.example
!config/config.toml
# But NEVER let a real mcp.json with tokens slip in
config/mcp.json

# per-skill local overrides (never committed)
skills/*/SKILL.md.local

# swarm runtime state — worker spawn manifests + scope files. These contain
# machine-specific paths (worktree locations, branch SHAs) and must never
# reach git. The example conflict-config.yaml.example is the only file
# under .jcode/ that should ever be committed.
.jcode/*
!.jcode/*.example

# macOS
.DS_Store

# editor
.vscode/
.idea/
*.swp
*.swo

# python bytecode (generated when running scripts/test_*.py)
__pycache__/
*.pyc

# build artifacts (none here, but be safe)
target/
build/
dist/
*.log

# shell installer scratch
*.download
installer.tmp