#!/usr/bin/env python3
"""rule-drop : find the rules a rewrite actually dropped.

    ./rule-drop <file> [--before <ref>]

scripts/rule-inventory scores a rule by content-word coverage over the whole
rewritten file. That measure is a triage aid, not a gate. Its own weakness was
measured on 2026-11-21: deleting one HEAD rule at a time and re-scoring left
44 of 49 swarm-prompt rules, 146 of 148 overlay rules and 180 of 183 Skill
rules still reported as kept, because the rule's content words survive
elsewhere in the file.

This tool asks the stricter question. For every rule in the baseline, it asks
whether some other rule in the rewrite carries that rule's content words. A
rule that was merged into a longer rule still matches, because a rule that
contains the words contains the claim. A rule that was deleted, or replaced by
a different claim, does not.

Both sides of the comparison are measured the same way, and that is the part
that makes the measure work. A file wraps its prose at about 78 columns, so a
rule that spans two lines is two fragments unless the lines are joined first.
Joining the lines before splitting into rules means the baseline and the
rewrite are compared claim by claim, not fragment by fragment.

Matching against the rewrite's rules rather than against all of its sentences
is the other half. A rule's words very often appear in some unrelated
sentence elsewhere in the file, and matching against everything scores those
as survivors.

The measure is the share of a rule's content words found in the best-matching
rule of the rewrite. A threshold of 0.5 is the same bar rule-inventory uses,
applied per rule instead of per file.

It also reports the score of every rule, so a rule that sits just above the
threshold is visible as a rule to read by hand.

Exit status is 0 when no rule falls below the threshold and 1 when one does.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import pathlib
import re
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
RI = REPO / "scripts" / "rule-inventory"

loader = importlib.machinery.SourceFileLoader("ri", str(RI))
spec = importlib.util.spec_from_loader("ri", loader)
ri = importlib.util.module_from_spec(spec)
loader.exec_module(ri)

# The share of a rule's content words a rule has to carry for the rule to
# count as still present. This is the same bar rule-inventory applies, moved
# from the whole file to one rule.
THRESHOLD = 0.5

# A bullet, a numbered item, or a plain paragraph. The file wraps prose, so
# the lines of a paragraph are joined before it is split into sentences.
BULLET = re.compile(r"^([-*]|\d+\.)\s+")
SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+")


def units(text: str) -> list[str]:
    """The text as unwrapped blocks: one per bullet or paragraph.

    A bullet's continuation lines belong to the bullet. The file wraps prose,
    so a bullet that runs to three physical lines is one claim, not three.
    Joining the continuation lines into their bullet is what keeps a rewrite
    that only rewraps a claim from looking like a dropped rule.
    """
    blocks: list[str] = []
    for block in re.split(r"\n\s*\n", text):
        lines = [
            ln.strip()
            for ln in block.splitlines()
            if ln.strip() and not ln.strip().startswith("#")
        ]
        if not lines:
            continue
        current: list[str] = []
        bullet_open = False
        for line in lines:
            if BULLET.match(line):
                if current:
                    blocks.append(" ".join(current))
                    current = []
                current = [line]
                bullet_open = True
            elif bullet_open:
                # A continuation line of the bullet above it.
                current.append(line)
            else:
                current.append(line)
        if current:
            blocks.append(" ".join(current))
    return blocks


def rules_of(text: str) -> list[tuple[str, str]]:
    """Every rule in the text, as (normalized text, the rule as written).

    A bullet is one claim even when it holds several sentences, so a bullet
    is kept whole. A paragraph is split into sentences, because a paragraph
    can hold several claims.
    """
    out: list[tuple[str, str]] = []
    for block in units(text):
        if BULLET.match(block):
            norm = ri.normalize(block)
            if norm and ri.classify(block) is not None:
                out.append((norm, block))
            continue
        for part in SENTENCE_SPLIT.split(block):
            part = part.strip()
            if not part:
                continue
            if ri.classify(part) is None:
                continue
            norm = ri.normalize(part)
            if norm:
                out.append((norm, part))
    return out


def best_match(rule_norm: str, candidates: list[tuple[str, str]]) -> tuple[float, str]:
    """The best score any rule of the rewrite gives the rule."""
    words = ri.content_words(rule_norm)
    if not words:
        return 1.0, ""
    best_score = 0.0
    best_candidate = ""
    for cand_norm, cand_raw in candidates:
        cand_words = set(cand_norm.split())
        if not cand_words:
            continue
        score = sum(1 for w in words if w in cand_words) / len(words)
        if score > best_score:
            best_score = score
            best_candidate = cand_raw
    return best_score, best_candidate


def read_before(path: str, ref: str) -> str:
    out = subprocess.run(
        ["git", "show", f"{ref}:{path}"],
        capture_output=True,
        text=True,
    )
    if out.returncode != 0:
        sys.stderr.write(f"cannot read {ref}:{path}\n")
        sys.exit(2)
    return out.stdout


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="rule-drop")
    ap.add_argument("file")
    ap.add_argument("--before", help="git ref to compare against")
    ap.add_argument("--threshold", type=float, default=THRESHOLD)
    ap.add_argument("--show", action="store_true", help="print every rule score")
    args = ap.parse_args(argv[1:])

    after_text = pathlib.Path(args.file).read_text(encoding="utf-8")
    candidates = rules_of(after_text)

    before_text = read_before(args.file, args.before) if args.before else after_text
    before_rules = rules_of(before_text)

    dropped: list[tuple[str, float]] = []
    thin: list[tuple[str, float]] = []
    for norm, raw in before_rules:
        if not ri.content_words(norm):
            continue
        score, _ = best_match(norm, candidates)
        if score < args.threshold:
            dropped.append((raw, score))
        elif score < 0.75:
            thin.append((raw, score))
        if args.show:
            print(f"{score:.2f}  {raw[:96]}")

    print(f"# {args.file}: {len(before_rules)} baseline rules, "
          f"threshold {args.threshold:.0%}")
    print(f"# {len(dropped)} dropped, {len(thin)} thin")
    if dropped:
        print()
        print("## dropped")
        for raw, score in dropped:
            print(f"  - [{score:.0%}] {raw}")
            print(f"      (content words: {' '.join(ri.content_words(ri.normalize(raw)))})")
    if thin:
        print()
        print("## thin, read these by hand")
        for raw, score in thin:
            print(f"  - [{score:.0%}] {raw}")
    return 1 if dropped else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
