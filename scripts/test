#!/usr/bin/env bash
# test : exercise the real install and uninstall scripts
#
# Usage:
#   ./scripts/test              # run every check
#   ./scripts/test --help       # show this header
#
# This runs the actual scripts/install and scripts/uninstall, not a copy of
# their logic. Every check drives the real script against a throwaway HOME
# and asserts on the real output and the real filesystem state.
#
# The sandbox lives under $TMPDIR and is removed on exit. The real $HOME is
# never written to: every install and uninstall runs with HOME pointed at
# the sandbox. XDG_STATE_HOME is pinned too, because scripts/common.sh
# derives the state directory from it and would otherwise escape the
# sandbox.
#
# Checks:
#   1. install --dry-run on a clean HOME exits 0
#   2. install --dry-run leaves the sandbox byte-identical
#   3. install --dry-run claims nothing was installed
#   4. install --dry-run announces what it would do
#   5. install --check writes nothing and reports its result
#   6. a real install writes config, skills and state
#   7. install --check detects missing live prompt files
#   8. install --check passes all 5 checks when nothing has drifted
#   9. a second install is idempotent
#   10. uninstall --dry-run removes nothing
#   11. uninstall --dry-run claims nothing was removed
#   12. uninstall removes state.json
#   13. uninstall --full --yes removes config and skills
#   14. uninstall never touches the jcode binary
#   15. the --dry-run predicts the real install, for every home shape
#   16. argument handling: --help and unknown arguments
#   17. the installer never writes to the repo
#
# "Leaves the sandbox byte-identical" covers both HOME and XDG_STATE_HOME.
# The state directory is not under HOME, so fingerprinting HOME alone would
# miss a dry-run that wrote state.json.
#
# Exit codes:
#   0  all checks passed
#   1  a check failed
#   2  bad arguments

set -euo pipefail

# shellcheck source=scripts/common.sh
. "$(dirname "$0")/common.sh"

# testlib.sh holds the helpers both test scripts share.
#
# It is separate from common.sh on purpose: common.sh sets `set -euo
# pipefail`, and scripts/doc-check has to drive commands that are
# expected to fail, so it cannot source common.sh. A shared helper must
# not change how a script that sources it behaves.
# shellcheck source=scripts/testlib.sh
. "$(dirname "$0")/testlib.sh"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help) usage ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

pass=0
fail=0

ok()   { pass=$((pass+1)); echo "  ok   $1"; }
bad()  {
    fail=$((fail+1))
    echo "  FAIL $1"
    shift || true
    for extra in "$@"; do
        echo "       $extra"
    done
}

# assert_eq <label> <expected> <actual>
assert_eq() {
    if [[ "$2" == "$3" ]]; then
        ok "$1"
    else
        bad "$1" "expected: $2" "actual:   $3"
    fi
}

# assert_contains <label> <needle> <haystack>
assert_contains() {
    if [[ "$3" == *"$2"* ]]; then
        ok "$1"
    else
        bad "$1" "expected to contain: $2" "actual: $3"
    fi
}

# assert_not_contains <label> <needle> <haystack>
assert_not_contains() {
    if [[ "$3" != *"$2"* ]]; then
        ok "$1"
    else
        bad "$1" "expected NOT to contain: $2" "actual: $3"
    fi
}

# assert_ne <label> <a> <b>
#
# The two values must DIFFER. Used where equality is the failure.
assert_ne() {
    if [[ "$2" != "$3" ]]; then
        ok "$1"
    else
        bad "$1" "expected the two values to differ" "both: $2"
    fi
}

# The fingerprint of a sandbox tree: every path with its type and content.
# Used to prove that a dry-run changed nothing.
#
# tree_fingerprint itself lives in testlib.sh. It used to be a copy in
# this file and a second copy in scripts/doc-check, which meant a fix to
# one would silently not apply to the other, and the two suites could
# disagree about the same tree.

SANDBOX="$(mktemp -d "${TMPDIR:-/tmp}/lazible-jcode-test.XXXXXX")"
trap 'rm -rf "$SANDBOX"' EXIT

# ---------------------------------------------------------------------------
# 0. the fingerprint itself
#
# The fingerprint is what every "nothing changed" claim rests on, so it is
# checked on its own terms first. A fingerprint that cannot see a change
# would make every other check vacuous.
# ---------------------------------------------------------------------------

echo "lazible-jcode installer tests"
echo ""
echo "=== the fingerprint detects change ==="

FP="$SANDBOX/fingerprint"
mkdir -p "$FP/dir"
printf 'hello' > "$FP/file.txt"

fp_a="$(tree_fingerprint "$FP")"

# Same length, different content. A size-only fingerprint would miss this,
# and state.json's timestamp is exactly this shape.
printf 'world' > "$FP/file.txt"
fp_b="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a same-length content change" "$fp_a" "$fp_b"

# A different length.
printf 'world and more' > "$FP/file.txt"
fp_c="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a length change" "$fp_b" "$fp_c"

# An unchanged tree is unchanged.
fp_d="$(tree_fingerprint "$FP")"
assert_eq "the fingerprint is stable on an unchanged tree" "$fp_c" "$fp_d"

# A retargeted symlink.
mkdir -p "$FP/target1" "$FP/target2"
printf 'one' > "$FP/target1/a.txt"
printf 'two' > "$FP/target2/b.txt"
ln -s "$FP/target1" "$FP/link"
fp_e="$(tree_fingerprint "$FP")"
rm "$FP/link"
ln -s "$FP/target2" "$FP/link"
fp_f="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a retargeted symlink" "$fp_e" "$fp_f"

# A symlink replaced by a real directory of the same name.
mkdir -p "$FP/real"
printf 'x' > "$FP/real/f.txt"
fp_g="$(tree_fingerprint "$FP")"
rm "$FP/link"
mkdir "$FP/link"
printf 'x' > "$FP/link/f.txt"
fp_h="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a symlink replaced by a directory" "$fp_g" "$fp_h"

# Two DIFFERENT targets with IDENTICAL content. The content of both
# targets is already inside the tree, so the target's path is the only
# thing that distinguishes them. A fingerprint that dropped the link
# target would call these two trees the same.
mkdir -p "$FP/twins/a" "$FP/twins/b"
printf 'same' > "$FP/twins/a/x.txt"
printf 'same' > "$FP/twins/b/x.txt"
ln -s "$FP/twins/a" "$FP/twin"
fp_i="$(tree_fingerprint "$FP")"
rm "$FP/twin"
ln -s "$FP/twins/b" "$FP/twin"
fp_j="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a retarget onto an identical-content target" \
    "$fp_i" "$fp_j"

# A symlink whose target lives OUTSIDE the tree. The tree's own entries
# cannot describe what the link points at, so the fingerprint has to
# follow the link. Otherwise a change behind the link is invisible.
OUTSIDE="$SANDBOX/outside"
mkdir -p "$OUTSIDE/target"
printf 'v1' > "$OUTSIDE/target/x.txt"
mkdir -p "$FP/links"
ln -s "$OUTSIDE/target" "$FP/links/out"
fp_k="$(tree_fingerprint "$FP")"
printf 'v2' > "$OUTSIDE/target/x.txt"
fp_l="$(tree_fingerprint "$FP")"
assert_ne "the fingerprint sees a change behind a link out of the tree" \
    "$fp_k" "$fp_l"

SBHOME="$SANDBOX/home"
SBSTATE="$SANDBOX/state"
mkdir -p "$SBHOME"
export HOME="$SBHOME"
export XDG_STATE_HOME="$SBSTATE"

# The fingerprint of every location the installer could write to. The state
# directory lives under XDG_STATE_HOME, which is NOT under HOME, so a
# fingerprint of HOME alone would miss a dry-run that wrote state.json.
sandbox_fingerprint() {
    tree_fingerprint "$SBHOME"
    tree_fingerprint "$SBSTATE"
}

echo "lazible-jcode installer tests"
echo ""
echo "  sandbox HOME: $SBHOME"
echo ""

# ---------------------------------------------------------------------------
# 1-4. install --dry-run on a clean HOME
# ---------------------------------------------------------------------------

echo "=== install --dry-run (clean HOME) ==="

before="$(sandbox_fingerprint)"

set +e
dry_out="$("$REPO/scripts/install" --dry-run 2>&1)"
dry_rc=$?
set -e

assert_eq "dry-run exits 0 on a clean HOME" "0" "$dry_rc"

after="$(sandbox_fingerprint)"
assert_eq "dry-run leaves the sandbox byte-identical" "$before" "$after"

# The state directory is outside HOME, so it needs its own assertion.
assert_eq "dry-run does not create the state directory" "" \
    "$(find "$SBSTATE" -mindepth 1 2>/dev/null | head -1)"

# A dry-run must not claim that anything was installed or completed.
assert_not_contains "dry-run does not claim 'config installed'" \
    "config installed" "$dry_out"
assert_not_contains "dry-run does not claim 'skills installed'" \
    "skills installed" "$dry_out"

# It must say what it would do.
assert_contains "dry-run says it would install the config" \
    "would install config" "$dry_out"
assert_contains "dry-run says it would install the skills" \
    "would install skills" "$dry_out"
assert_contains "dry-run says it would write the state file" \
    "would write:" "$dry_out"
assert_contains "dry-run ends with a dry-run completion notice" \
    "dry-run complete" "$dry_out"

# ---------------------------------------------------------------------------
# 5. install --check on a clean HOME
# ---------------------------------------------------------------------------

echo ""
echo "=== install --check (clean HOME) ==="

set +e
check_out="$("$REPO/scripts/install" --check 2>&1)"
check_rc=$?
set -e

# On a clean HOME the config is not there yet, so --check reports failures.
# It must still exit without crashing, and it must say what failed.
assert_contains "--check reports its result" "verify:" "$check_out"
assert_eq "--check exits non-zero on a clean HOME" "6" "$check_rc"

# --check must not write anything either.
after_check="$(sandbox_fingerprint)"
assert_eq "--check leaves the sandbox byte-identical" "$before" "$after_check"

# ---------------------------------------------------------------------------
# 6-8. a real install
# ---------------------------------------------------------------------------

echo ""
echo "=== install (real) ==="

set +e
install_out="$("$REPO/scripts/install" 2>&1)"
install_rc=$?
set -e

assert_eq "real install exits 0" "0" "$install_rc"
assert_contains "real install reports the config" \
    "config installed" "$install_out"
assert_contains "real install reports the skills" \
    "skills installed" "$install_out"

if [[ -f "$SBHOME/.jcode/config.toml" ]]; then
    ok "real install wrote config.toml"
else
    bad "real install wrote config.toml" "not found at $SBHOME/.jcode/config.toml"
fi

if cmp -s "$REPO/config/config.toml" "$SBHOME/.jcode/config.toml"; then
    ok "installed config matches config/config.toml"
else
    bad "installed config matches config/config.toml" "content differs"
fi

if [[ -f "$SBHOME/.jcode/skills/swarm-engineering/SKILL.md" ]]; then
    ok "real install wrote the swarm-engineering skill"
else
    bad "real install wrote the swarm-engineering skill" "not found"
fi

if [[ -f "$XDG_STATE_HOME/lazible-jcode/state.json" ]]; then
    ok "real install wrote state.json"
else
    bad "real install wrote state.json" "not found at $XDG_STATE_HOME/lazible-jcode/state.json"
fi

echo ""
echo "=== install --check (after a real install, no live prompt files) ==="

# install never writes ~/.jcode/prompt-overlay.md or ~/.jcode/swarm-prompt.md.
# In a sandbox they are absent, so --check correctly reports prompt drift.
# Under --check that drift is a failure, so the exit code is 6.
set +e
check2_out="$("$REPO/scripts/install" --check 2>&1)"
check2_rc=$?
set -e

assert_eq "--check exits 6 when the live prompt files are missing" "6" "$check2_rc"
assert_contains "--check reports 4 passed, 0 failed, 1 warning" \
    "verify: 4 passed, 0 failed, 1 warning" "$check2_out"
assert_contains "--check names the prompt drift" \
    "prompt-overlay.md / swarm-prompt.md vs live" "$check2_out"

echo ""
echo "=== install --check (with the live prompt files in place) ==="

# Seed the sandbox with the repo's own copies of the two prompt files, the
# same state the real machine is in. --check must then pass all 5 checks.
mkdir -p "$SBHOME/.jcode"
for f in prompt-overlay.md swarm-prompt.md; do
    cp "$REPO/config/$f" "$SBHOME/.jcode/$f"
done

set +e
check3_out="$("$REPO/scripts/install" --check 2>&1)"
check3_rc=$?
set -e

assert_eq "--check exits 0 when nothing has drifted" "0" "$check3_rc"
assert_contains "--check reports 5 passed, 0 failed, 0 warnings" \
    "verify: 5 passed, 0 failed, 0 warnings" "$check3_out"

echo ""
echo "=== install (idempotency) ==="

before_second="$(sandbox_fingerprint)"
set +e
"$REPO/scripts/install" >/dev/null 2>&1
second_rc=$?
set -e
after_second="$(sandbox_fingerprint)"

assert_eq "second install exits 0" "0" "$second_rc"
assert_eq "second install changes nothing" "$before_second" "$after_second"

# ---------------------------------------------------------------------------
# 9-10. uninstall --dry-run
# ---------------------------------------------------------------------------

echo ""
echo "=== uninstall --dry-run ==="

before_udry="$(sandbox_fingerprint)"

set +e
udry_out="$("$REPO/scripts/uninstall" --dry-run 2>&1)"
udry_rc=$?
set -e

assert_eq "uninstall --dry-run exits 0" "0" "$udry_rc"

after_udry="$(sandbox_fingerprint)"
assert_eq "uninstall --dry-run removes nothing" "$before_udry" "$after_udry"

assert_not_contains "uninstall --dry-run does not claim 'uninstall complete'" \
    "uninstall complete" "$udry_out"
assert_contains "uninstall --dry-run says it would remove" \
    "would remove" "$udry_out"
assert_contains "uninstall --dry-run ends with a dry-run completion notice" \
    "dry-run complete" "$udry_out"

# ---------------------------------------------------------------------------
# 11. uninstall removes state.json
# ---------------------------------------------------------------------------

echo ""
echo "=== uninstall (state only) ==="

set +e
un_out="$("$REPO/scripts/uninstall" --yes 2>&1)"
un_rc=$?
set -e

assert_eq "uninstall exits 0" "0" "$un_rc"
assert_contains "uninstall reports completion" "uninstall complete" "$un_out"

if [[ ! -f "$XDG_STATE_HOME/lazible-jcode/state.json" ]]; then
    ok "uninstall removed state.json"
else
    bad "uninstall removed state.json" "still present"
fi

if [[ -f "$SBHOME/.jcode/config.toml" ]]; then
    ok "uninstall left config.toml in place"
else
    bad "uninstall left config.toml in place" "it was removed"
fi

# ---------------------------------------------------------------------------
# 12. uninstall --full removes config and skills
# ---------------------------------------------------------------------------

echo ""
echo "=== uninstall --full --yes ==="

set +e
uf_out="$("$REPO/scripts/uninstall" --full --yes 2>&1)"
uf_rc=$?
set -e

assert_eq "uninstall --full exits 0" "0" "$uf_rc"
assert_contains "uninstall --full reports completion" "uninstall complete" "$uf_out"

if [[ ! -f "$SBHOME/.jcode/config.toml" ]]; then
    ok "uninstall --full removed config.toml"
else
    bad "uninstall --full removed config.toml" "still present"
fi

if [[ ! -d "$SBHOME/.jcode/skills/swarm-engineering" ]]; then
    ok "uninstall --full removed the repo's skills"
else
    bad "uninstall --full removed the repo's skills" "still present"
fi

# ---------------------------------------------------------------------------
# 13. uninstall never touches the jcode binary
# ---------------------------------------------------------------------------

echo ""
echo "=== preservation ==="

# A fake binary in the sandbox. uninstall must not remove it.
mkdir -p "$SBHOME/.local/bin"
printf '#!/bin/sh\necho jcode\n' > "$SBHOME/.local/bin/jcode"
chmod +x "$SBHOME/.local/bin/jcode"

set +e
"$REPO/scripts/uninstall" --full --yes >/dev/null 2>&1
set -e

if [[ -f "$SBHOME/.local/bin/jcode" ]]; then
    ok "uninstall never removes the jcode binary"
else
    bad "uninstall never removes the jcode binary" "it was removed"
fi

# ---------------------------------------------------------------------------
# 14. the dry-run predicts the real install
#
# A preview that promises a success the real run cannot deliver is worse
# than no preview. For each environment shape, the dry-run and the real
# install have to reach the same verdict.
# ---------------------------------------------------------------------------

echo ""
echo "=== dry-run fidelity (the preview must match the real install) ==="

# fidelity <label> <setup function name>
#
# A setup function prepares a case directory and may set CASE_STATE to
# point XDG_STATE_HOME somewhere other than the default, for cases where
# the state directory's own location is what is being tested.
fidelity() {
    local label="$1" setup_fn="$2"
    local case_dir="$SANDBOX/case"
    rm -rf "$case_dir"
    mkdir -p "$case_dir"

    CASE_STATE=""
    "$setup_fn" "$case_dir"

    local saved_home="$HOME" saved_state="$XDG_STATE_HOME"
    export HOME="$case_dir/home"
    export XDG_STATE_HOME="${CASE_STATE:-$case_dir/state}"

    local dry_out real_out dry_rc real_rc
    set +e
    dry_out="$("$REPO/scripts/install" --dry-run 2>&1)"
    dry_rc=$?
    real_out="$("$REPO/scripts/install" 2>&1)"
    real_rc=$?
    set -e

    export HOME="$saved_home"
    export XDG_STATE_HOME="$saved_state"

    local dry_ok="no" real_ok="no"
    [[ "$dry_out" == *"preflight ok"* ]] && dry_ok="yes"
    [[ "$real_out" == *"preflight ok"* ]] && real_ok="yes"

    if [[ "$dry_ok" == "$real_ok" ]]; then
        ok "$label: the dry-run predicts the real install"
    else
        bad "$label: the dry-run predicts the real install" \
            "dry-run: rc=$dry_rc preflight_ok=$dry_ok" \
            "real:    rc=$real_rc preflight_ok=$real_ok"
    fi

    # Both runs must also agree on whether they succeeded.
    if [[ "$dry_rc" -eq 0 && "$real_rc" -eq 0 ]]; then
        ok "$label: both the dry-run and the real install succeed"
    elif [[ "$dry_rc" -ne 0 && "$real_rc" -ne 0 ]]; then
        ok "$label: both the dry-run and the real install fail"
    else
        bad "$label: both the dry-run and the real install agree on success" \
            "dry-run rc=$dry_rc, real rc=$real_rc"
    fi
}

setup_normal() {
    mkdir -p "$1/home" "$1/state"
}

setup_no_home() {
    mkdir -p "$1"
}

setup_jcode_is_file() {
    mkdir -p "$1/home" "$1/state"
    printf 'not a directory\n' > "$1/home/.jcode"
}

setup_jcode_is_dangling_link() {
    mkdir -p "$1/home" "$1/state"
    ln -s "$1/gone" "$1/home/.jcode"
}

setup_jcode_is_link_to_dir() {
    mkdir -p "$1/home" "$1/state" "$1/real"
    ln -s "$1/real" "$1/home/.jcode"
}

setup_home_readonly() {
    mkdir -p "$1/home" "$1/state"
    chmod 500 "$1/home"
}

# The state directory's PARENT is a dangling symlink. The checked path
# itself is not a symlink here, so this exercises the ancestor walk rather
# than the explicit symlink test on the path.
setup_state_parent_is_dangling_link() {
    mkdir -p "$1/home"
    ln -s "$1/gone" "$1/state-link"
    CASE_STATE="$1/state-link"
}

fidelity "a normal writable HOME" setup_normal
fidelity "HOME does not exist" setup_no_home
# The labels below contain a literal tilde on purpose: they name the path
# shape, they are not paths to expand.
# shellcheck disable=SC2088
fidelity "~/.jcode is a regular file" setup_jcode_is_file
# shellcheck disable=SC2088
fidelity "~/.jcode is a dangling symlink" setup_jcode_is_dangling_link
# shellcheck disable=SC2088
fidelity "~/.jcode symlinks to a directory" setup_jcode_is_link_to_dir
fidelity "HOME is read-only" setup_home_readonly
fidelity "the state dir's parent is a dangling symlink" \
    setup_state_parent_is_dangling_link

# The read-only HOME has to be made writable again or the sandbox cannot
# be removed.
chmod -R u+w "$SANDBOX" 2>/dev/null || true

# ---------------------------------------------------------------------------
# 15. argument handling
# ---------------------------------------------------------------------------

echo ""
echo "=== argument handling ==="

set +e
help_out="$("$REPO/scripts/install" --help 2>&1)"
help_rc=$?
set -e
assert_eq "install --help exits 0" "0" "$help_rc"
assert_contains "install --help shows the usage block" "Usage:" "$help_out"

set +e
bad_out="$("$REPO/scripts/install" --not-an-option 2>&1)"
bad_rc=$?
set -e
assert_eq "install rejects an unknown argument with exit 2" "2" "$bad_rc"
assert_contains "install names the unknown argument" "unknown arg" "$bad_out"

set +e
uhelp_out="$("$REPO/scripts/uninstall" --help 2>&1)"
uhelp_rc=$?
set -e
assert_eq "uninstall --help exits 0" "0" "$uhelp_rc"
assert_contains "uninstall --help shows the usage block" "Usage:" "$uhelp_out"

set +e
ubad_out="$("$REPO/scripts/uninstall" --not-an-option 2>&1)"
ubad_rc=$?
set -e
assert_eq "uninstall rejects an unknown argument with exit 2" "2" "$ubad_rc"
assert_contains "uninstall names the unknown argument" "unknown arg" "$ubad_out"

# --dry-run together with --check must stay read-only.
before_combo="$(sandbox_fingerprint)"
set +e
combo_out="$("$REPO/scripts/install" --dry-run --check 2>&1)"
combo_rc=$?
set -e
after_combo="$(sandbox_fingerprint)"
assert_eq "install --dry-run --check exits 0" "0" "$combo_rc"
assert_eq "install --dry-run --check changes nothing" "$before_combo" "$after_combo"
assert_contains "install --dry-run --check announces both modes" \
    "CHECK-ONLY" "$combo_out"

# uninstall --full --dry-run must remove nothing.
set +e
full_dry_out="$("$REPO/scripts/uninstall" --full --dry-run 2>&1)"
full_dry_rc=$?
set -e
after_full_dry="$(sandbox_fingerprint)"
assert_eq "uninstall --full --dry-run exits 0" "0" "$full_dry_rc"
assert_eq "uninstall --full --dry-run changes nothing" "$before_combo" "$after_full_dry"
assert_contains "uninstall --full --dry-run announces the dry-run" \
    "DRY-RUN" "$full_dry_out"

# ---------------------------------------------------------------------------
# 17. the repo is read-only to the installer
#
# These use a THROWAWAY COPY of the repo as the symlink target, never the
# real one. A test must never be able to damage the repository it runs in.
# ---------------------------------------------------------------------------

echo ""
echo "=== the repo is read-only to the installer ==="

repo_before="$(tree_fingerprint "$REPO")"
set +e
"$REPO/scripts/install" --dry-run >/dev/null 2>&1
"$REPO/scripts/install" --check >/dev/null 2>&1
set -e
repo_after="$(tree_fingerprint "$REPO")"
assert_eq "the installer never writes to the repo" "$repo_before" "$repo_after"

# ---------------------------------------------------------------------------
# 18. the repo boundary holds against symlinks
#
# A symlinked ~/.jcode redirects every write below it. If it points at the
# repo, install would overwrite the very files it copies from, and uninstall
# would delete them. Both scripts must refuse.
# ---------------------------------------------------------------------------

echo ""
echo "=== the repo boundary holds against symlinks ==="

# A throwaway copy of the repo, used as the "repo" that the symlinks point
# at. A test must never be able to damage the repository it runs in, so the
# real repo is never the target of a symlink here.
mkdir -p "$SANDBOX/boundary"
BOUNDARY_REPO="$SANDBOX/boundary/repo"
mkdir -p "$BOUNDARY_REPO/config/skills/swarm-engineering"
cp "$REPO/config/config.toml" "$BOUNDARY_REPO/config/config.toml"
cp "$REPO/config/skills/swarm-engineering/SKILL.md" \
   "$BOUNDARY_REPO/config/skills/swarm-engineering/SKILL.md"
mkdir -p "$BOUNDARY_REPO/scripts"
cp "$REPO/scripts/install" "$REPO/scripts/uninstall" "$REPO/scripts/common.sh" \
   "$BOUNDARY_REPO/scripts/"

# A real directory inside the repo, used as the target of the redirected
# state path. It has to EXIST: a dangling symlink would be caught by the
# preflight's own dangling-symlink check, and the test would then pass for
# the wrong reason instead of proving the repo boundary.
mkdir -p "$BOUNDARY_REPO/state-in-repo"

# A skills directory inside the repo whose own skill points back OUT of
# the repo. Case 6c redirects the live skills dir at it.
#
# It is created BEFORE the fingerprint below, so the baseline includes it.
# A fixture added after the baseline would make the final comparison fail
# for the wrong reason: the test would be measuring its own setup.
mkdir -p "$BOUNDARY_REPO/other-skills" "$SANDBOX/outside-skill"
printf 'outside skill\n' > "$SANDBOX/outside-skill/SKILL.md"
ln -s "$SANDBOX/outside-skill" \
    "$BOUNDARY_REPO/other-skills/swarm-engineering"

boundary_before="$(tree_fingerprint "$BOUNDARY_REPO")"

# Case 1: ~/.jcode is a symlink into the repo.
mkdir -p "$SANDBOX/b1/home" "$SANDBOX/b1/state"
ln -s "$BOUNDARY_REPO" "$SANDBOX/b1/home/.jcode"
set +e
b1_out="$(HOME="$SANDBOX/b1/home" XDG_STATE_HOME="$SANDBOX/b1/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b1_rc=$?
set -e
assert_contains "install refuses a ~/.jcode symlinked into the repo" \
    "resolves inside this repo" "$b1_out"
assert_eq "install exits non-zero when the target is inside the repo" \
    "1" "$b1_rc"

# Case 2: ~/.jcode/skills is a symlink into the repo.
mkdir -p "$SANDBOX/b2/home/.jcode" "$SANDBOX/b2/state"
ln -s "$BOUNDARY_REPO/config" "$SANDBOX/b2/home/.jcode/skills"
set +e
b2_out="$(HOME="$SANDBOX/b2/home" XDG_STATE_HOME="$SANDBOX/b2/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b2_rc=$?
set -e
assert_contains "install refuses a skills dir symlinked into the repo" \
    "resolves inside this repo" "$b2_out"
assert_eq "install exits non-zero when skills point into the repo" \
    "1" "$b2_rc"

# Case 3: uninstall --full with ~/.jcode symlinked into the repo.
mkdir -p "$SANDBOX/b3/home" "$SANDBOX/b3/state"
ln -s "$BOUNDARY_REPO" "$SANDBOX/b3/home/.jcode"
set +e
b3_out="$(HOME="$SANDBOX/b3/home" XDG_STATE_HOME="$SANDBOX/b3/state" \
    "$BOUNDARY_REPO/scripts/uninstall" --full --yes 2>&1)"
b3_rc=$?
set -e
assert_contains "uninstall refuses to delete from inside the repo" \
    "resolves inside this repo" "$b3_out"
assert_eq "uninstall exits non-zero when the target is inside the repo" \
    "1" "$b3_rc"

# Case 4: the dry-run must predict the refusal, not preview a deletion.
set +e
b4_out="$(HOME="$SANDBOX/b3/home" XDG_STATE_HOME="$SANDBOX/b3/state" \
    "$BOUNDARY_REPO/scripts/uninstall" --full --dry-run 2>&1)"
b4_rc=$?
set -e
assert_contains "uninstall --dry-run predicts the repo-boundary refusal" \
    "resolves inside this repo" "$b4_out"
assert_eq "uninstall --dry-run exits non-zero inside the repo" \
    "1" "$b4_rc"

# Case 5: the state path is redirected into the repo.
#
# The redirect target EXISTS, so the preflight's dangling-symlink check
# cannot catch this. Only the repo boundary can.
mkdir -p "$SANDBOX/b6/home"
ln -s "$BOUNDARY_REPO/state-in-repo" "$SANDBOX/b6/state"
set +e
b6_out="$(HOME="$SANDBOX/b6/home" XDG_STATE_HOME="$SANDBOX/b6/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b6_rc=$?
set -e
assert_contains "install refuses a state path redirected into the repo" \
    "resolves inside this repo" "$b6_out"
assert_eq "install exits non-zero when the state path is inside the repo" \
    "1" "$b6_rc"

# And the refusal must have come BEFORE anything was created. If the state
# directory were made first, the mkdir would have put a directory inside
# the repo on the way out.
boundary_mid="$(tree_fingerprint "$BOUNDARY_REPO")"
assert_eq "a refused state path creates nothing inside the repo" \
    "$boundary_before" "$boundary_mid"

# Case 5b: only the STATE FILE is redirected into the repo, while the
# state DIRECTORY stays outside it.
#
# The directory is guarded separately, so this case is the only one that
# can prove the state file is guarded on its own. Without it, dropping
# the state file from the guard would change nothing observable.
mkdir -p "$SANDBOX/b6b/home" "$SANDBOX/b6b/state/lazible-jcode"
ln -s "$BOUNDARY_REPO/state-in-repo/state.json" \
    "$SANDBOX/b6b/state/lazible-jcode/state.json"
set +e
b6b_out="$(HOME="$SANDBOX/b6b/home" XDG_STATE_HOME="$SANDBOX/b6b/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b6b_rc=$?
set -e
assert_contains "install refuses a state FILE redirected into the repo" \
    "resolves inside this repo" "$b6b_out"
assert_eq "install exits non-zero when the state file is inside the repo" \
    "1" "$b6b_rc"
if [[ -e "$BOUNDARY_REPO/state-in-repo/state.json" ]]; then
    bad "a refused state file writes nothing into the repo" \
        "state.json was written into the repo"
else
    ok "a refused state file writes nothing into the repo"
fi

# Case 6: only the skills directory is redirected into the repo. The
# config path is fine, so only the skills guard can catch this.
mkdir -p "$SANDBOX/b7/home/.jcode"
ln -s "$BOUNDARY_REPO/config/skills" "$SANDBOX/b7/home/.jcode/skills"
set +e
b7_out="$(HOME="$SANDBOX/b7/home" XDG_STATE_HOME="$SANDBOX/b7/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b7_rc=$?
set -e
assert_contains "install refuses a skills dir redirected into the repo" \
    "resolves inside this repo" "$b7_out"
assert_eq "install exits non-zero when the skills dir is inside the repo" \
    "1" "$b7_rc"

# Case 6b: only ONE SKILL's own directory is redirected into the repo.
#
# This is the same hazard one level down. Guarding the skills directory is
# not enough: the skills directory itself is real, so the guard on it sees
# nothing wrong, and the refusal would only arrive once phase 3 reached
# that skill, by which time phase 2 had already written config.toml.
mkdir -p "$SANDBOX/b7b/home/.jcode/skills" "$SANDBOX/b7b/state"
ln -s "$BOUNDARY_REPO/config/skills/swarm-engineering" \
    "$SANDBOX/b7b/home/.jcode/skills/swarm-engineering"
set +e
b7b_out="$(HOME="$SANDBOX/b7b/home" XDG_STATE_HOME="$SANDBOX/b7b/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b7b_rc=$?
set -e
assert_contains "install refuses a skill's own directory redirected into the repo" \
    "resolves inside this repo" "$b7b_out"
assert_eq "install exits non-zero when a skill dir is inside the repo" \
    "1" "$b7b_rc"

# The refusal has to come BEFORE anything is written. Otherwise the
# install is half done: the config is already in place when the refusal
# arrives.
if [[ -f "$SANDBOX/b7b/home/.jcode/config.toml" ]]; then
    bad "a refused skill dir writes nothing at all" \
        "config.toml was written before the refusal"
else
    ok "a refused skill dir writes nothing at all"
fi
if [[ -f "$SANDBOX/b7b/state/lazible-jcode/state.json" ]]; then
    bad "a refused skill dir writes no state file" \
        "state.json was written before the refusal"
else
    ok "a refused skill dir writes no state file"
fi

# Case 6c: the skills DIRECTORY is redirected into the repo, but the skill
# inside it points back out.
#
# This is the only case that proves the skills-directory guard does its own
# work. skill_targets holds $SKILLS_HOME/<skill>, and here that resolves
# OUTSIDE the repo while $SKILLS_HOME itself resolves inside it. So the
# skill-list guard sees nothing wrong, and only the skills-directory guard
# can catch it.
#
# It needs a symlink chain: $SKILLS_HOME -> <repo>/other-skills, and
# <repo>/other-skills/swarm-engineering -> a directory outside the repo.
# Both ends of the chain were built with the fingerprint baseline above.
mkdir -p "$SANDBOX/b7c/home/.jcode"
ln -s "$BOUNDARY_REPO/other-skills" "$SANDBOX/b7c/home/.jcode/skills"
set +e
b7c_out="$(HOME="$SANDBOX/b7c/home" XDG_STATE_HOME="$SANDBOX/b7c/state" \
    "$BOUNDARY_REPO/scripts/install" 2>&1)"
b7c_rc=$?
set -e
assert_contains "install refuses a skills dir in the repo even when the skill points out" \
    "resolves inside this repo" "$b7c_out"
assert_eq "install exits non-zero when only the skills dir is inside the repo" \
    "1" "$b7c_rc"
if [[ -f "$SANDBOX/b7c/home/.jcode/config.toml" ]]; then
    bad "a refused skills dir writes nothing at all" \
        "config.toml was written before the refusal"
else
    ok "a refused skills dir writes nothing at all"
fi

# The repo must be byte-identical after all of that.
boundary_after="$(tree_fingerprint "$BOUNDARY_REPO")"
assert_eq "the repo is byte-identical after every symlinked attempt" \
    "$boundary_before" "$boundary_after"

# Case 7: a refused uninstall must not have removed anything.
#
# The guard has to run BEFORE anything is deleted. If it only ran when the
# uninstaller reached the offending path, the state file would already be
# gone by then, and a refused uninstall would leave the machine half
# uninstalled.
mkdir -p "$SANDBOX/b8/home" "$SANDBOX/b8/state"
HOME="$SANDBOX/b8/home" XDG_STATE_HOME="$SANDBOX/b8/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
rm -rf "$SANDBOX/b8/home/.jcode/skills"
ln -s "$BOUNDARY_REPO/config/skills" "$SANDBOX/b8/home/.jcode/skills"
set +e
HOME="$SANDBOX/b8/home" XDG_STATE_HOME="$SANDBOX/b8/state" \
    "$BOUNDARY_REPO/scripts/uninstall" --full --yes >/dev/null 2>&1
b8_rc=$?
set -e
assert_eq "a refused uninstall exits non-zero" "1" "$b8_rc"
if [[ -f "$SANDBOX/b8/state/lazible-jcode/state.json" ]]; then
    ok "a refused uninstall removes nothing, not even the state file"
else
    bad "a refused uninstall removes nothing, not even the state file" \
        "the state file was deleted before the refusal"
fi
if [[ -f "$SANDBOX/b8/home/.jcode/config.toml" ]]; then
    ok "a refused uninstall leaves the config in place"
else
    bad "a refused uninstall leaves the config in place" "the config was removed"
fi

# Case 7b: the same, but with only ONE SKILL's own directory redirected.
#
# The uninstaller removes the skill directories, so a skill directory
# symlinked into the repo would make "rm -rf" delete the repo's own skill
# files. The refusal still has to be up front.
mkdir -p "$SANDBOX/b9/home" "$SANDBOX/b9/state"
HOME="$SANDBOX/b9/home" XDG_STATE_HOME="$SANDBOX/b9/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
rm -rf "$SANDBOX/b9/home/.jcode/skills/swarm-engineering"
ln -s "$BOUNDARY_REPO/config/skills/swarm-engineering" \
    "$SANDBOX/b9/home/.jcode/skills/swarm-engineering"
set +e
b9_out="$(HOME="$SANDBOX/b9/home" XDG_STATE_HOME="$SANDBOX/b9/state" \
    "$BOUNDARY_REPO/scripts/uninstall" --full --yes 2>&1)"
b9_rc=$?
set -e
assert_contains "uninstall refuses a skill's own directory redirected into the repo" \
    "resolves inside this repo" "$b9_out"
assert_eq "uninstall exits non-zero when a skill dir is inside the repo" \
    "1" "$b9_rc"
if [[ -f "$SANDBOX/b9/state/lazible-jcode/state.json" ]]; then
    ok "a refused skill dir removes nothing, not even the state file"
else
    bad "a refused skill dir removes nothing, not even the state file" \
        "the state file was deleted before the refusal"
fi
if [[ -f "$BOUNDARY_REPO/config/skills/swarm-engineering/SKILL.md" ]]; then
    ok "a refused skill dir leaves the repo's own skill file in place"
else
    bad "a refused skill dir leaves the repo's own skill file in place" \
        "the repo's SKILL.md was deleted"
fi

# ---------------------------------------------------------------------------
# 19. the shared guard itself
#
# The guard lives in common.sh so that both scripts enforce the same rule.
# These check the rule directly, which pins down exactly which paths are
# covered rather than only checking the ones a script happens to use.
# ---------------------------------------------------------------------------

echo ""
echo "=== the shared repo guard ==="

# A tiny harness that sources common.sh and calls the guard.
#
# It has to live inside the repo copy, because common.sh derives REPO from
# its own location. Sourced from elsewhere, REPO would be some unrelated
# directory and every path would look like it was inside the repo.
cat > "$BOUNDARY_REPO/scripts/guard-harness.sh" <<'GUARD'
#!/usr/bin/env bash
set -uo pipefail
. "$(dirname "$0")/common.sh"
guard_outside_repo "$@"
GUARD

guard_rc_of() {
    # guard_rc_of <path> -> the exit code of the guard for that path
    local p="$1" rc
    set +e
    bash "$BOUNDARY_REPO/scripts/guard-harness.sh" "$p" >/dev/null 2>&1
    rc=$?
    set -e
    echo "$rc"
}

assert_eq "the guard accepts a path outside the repo" "0" \
    "$(guard_rc_of "$SANDBOX/b5/home/config.toml")"
assert_eq "the guard rejects a path inside the repo" "1" \
    "$(guard_rc_of "$BOUNDARY_REPO/config/config.toml")"
assert_eq "the guard rejects a path inside the repo's subdirectory" "1" \
    "$(guard_rc_of "$BOUNDARY_REPO/config/skills")"
assert_eq "the guard rejects the repo root itself" "1" \
    "$(guard_rc_of "$BOUNDARY_REPO")"

# A symlink that points into the repo must be rejected too, even though
# the path itself is not under the repo.
mkdir -p "$SANDBOX/g/home"
ln -s "$BOUNDARY_REPO/config" "$SANDBOX/g/link-to-repo"
assert_eq "the guard rejects a symlink that points into the repo" "1" \
    "$(guard_rc_of "$SANDBOX/g/link-to-repo/config.toml")"

# A sibling directory whose name merely starts with the repo's name must
# NOT be rejected. That would make the guard refuse legitimate paths.
mkdir -p "$SANDBOX/repo-not-inside"
assert_eq "the guard accepts a sibling directory with a similar name" "0" \
    "$(guard_rc_of "$SANDBOX/repo-not-inside/config.toml")"

# A normal install must still work, so the guard is not simply refusing
# everything.
mkdir -p "$SANDBOX/b5/home" "$SANDBOX/b5/state"
set +e
HOME="$SANDBOX/b5/home" XDG_STATE_HOME="$SANDBOX/b5/state" \
    "$BOUNDARY_REPO/scripts/install" >/dev/null 2>&1
b5_rc=$?
set -e
assert_eq "install still works when nothing points into the repo" \
    "0" "$b5_rc"

# ---------------------------------------------------------------------------
# 20. a real install never writes to the repo
# ---------------------------------------------------------------------------

echo ""
echo "=== a real install never writes to the repo ==="

repo_before_real="$(tree_fingerprint "$REPO")"
mkdir -p "$SANDBOX/real/home" "$SANDBOX/real/state"
set +e
HOME="$SANDBOX/real/home" XDG_STATE_HOME="$SANDBOX/real/state" \
    "$REPO/scripts/install" >/dev/null 2>&1
real_rc=$?
set -e
repo_after_real="$(tree_fingerprint "$REPO")"
assert_eq "a real install exits 0" "0" "$real_rc"
assert_eq "a real install never writes to the repo" \
    "$repo_before_real" "$repo_after_real"

# ---------------------------------------------------------------------------
# 21. install is genuinely idempotent
#
# The fingerprint hashes file CONTENT, so this is a real check. It was
# vacuous before: state.json carried a fresh timestamp on every run, and
# the old fingerprint only compared file SIZES, which stayed identical.
# ---------------------------------------------------------------------------

echo ""
echo "=== install is idempotent ==="

# These installs run against the throwaway repo copy and write into their
# OWN sandbox, so the fingerprint has to cover that sandbox, not the
# suite's top-level one.
idem_home="$SANDBOX/real/home"
idem_state="$SANDBOX/real/state"
idem_state_file="$idem_state/lazible-jcode/state.json"
idem_fingerprint() {
    tree_fingerprint "$idem_home"
    tree_fingerprint "$idem_state"
}

# The recorded timestamp has ONE SECOND of resolution, so two installs
# inside the same second are indistinguishable by construction. Every
# timestamp comparison below therefore waits for the clock to move on.
# Without that wait the check would pass whether or not the timestamp
# logic works.
wait_for_next_second() {
    local now
    now="$(date +%S)"
    while [[ "$(date +%S)" == "$now" ]]; do
        sleep 0.05
    done
}

idem_install() {
    HOME="$idem_home" XDG_STATE_HOME="$idem_state" \
        "$1/scripts/install" >/dev/null 2>&1
}

idem_before="$(idem_fingerprint)"
set +e
idem_install "$REPO"
idem_rc=$?
set -e
idem_after="$(idem_fingerprint)"
assert_eq "a second install exits 0" "0" "$idem_rc"
assert_eq "a second install changes nothing, content included" \
    "$idem_before" "$idem_after"

# The timestamp must HOLD when nothing changed. That is what makes a
# second install a no-op.
installed_at_first="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
wait_for_next_second
set +e
idem_install "$REPO"
set -e
installed_at_second="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_eq "the recorded timestamp holds when nothing changed" \
    "$installed_at_first" "$installed_at_second"

# The timestamp must MOVE when the config actually changes. Otherwise
# "installed_at" would mean "when the script last ran", and the state file
# would be rewritten on every install for no reason. This runs against the
# throwaway repo copy, so the real config is never touched.
cp "$BOUNDARY_REPO/config/config.toml" "$SANDBOX/idem-config.toml"
printf '\n# a change\n' >> "$BOUNDARY_REPO/config/config.toml"
wait_for_next_second
set +e
idem_install "$BOUNDARY_REPO"
set -e
installed_at_changed="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_ne "the recorded timestamp moves when the config changes" \
    "$installed_at_first" "$installed_at_changed"

# And with the config unchanged again, the timestamp must hold. That is
# what makes a second install after a change a no-op too.
wait_for_next_second
changed_before="$(idem_fingerprint)"
set +e
idem_install "$BOUNDARY_REPO"
set -e
changed_after="$(idem_fingerprint)"
assert_eq "a second install after a config change is still a no-op" \
    "$changed_before" "$changed_after"
installed_at_stable="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_eq "the recorded timestamp holds after the config settled" \
    "$installed_at_changed" "$installed_at_stable"

# The recorded hash has to track the config that is actually on disk.
config_sha="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['config_sha256'])")"
real_sha="$(sha256sum "$BOUNDARY_REPO/config/config.toml" | cut -d' ' -f1)"
assert_eq "the recorded config hash matches the config on disk" \
    "$real_sha" "$config_sha"

# And the recorded skill list has to match the skills in the repo.
recorded_skills="$(python3 -c \
    "import json;print(' '.join(json.load(open('$idem_state_file'))['skills']))")"
repo_skills="$(cd "$BOUNDARY_REPO/config/skills" && find . -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort | tr '\n' ' ' | sed 's/ $//')"
assert_eq "the recorded skill list matches the skills in the repo" \
    "$repo_skills" "$recorded_skills"

# The timestamp must ALSO move when the SKILL LIST changes, with the
# config untouched. The README says the timestamp moves when "the config
# or the skill list actually changed", and those are two separate
# triggers. The config half was proven above; without this, the skill
# half would be an unbacked claim, and the state writer's skill
# comparison would be untested.
#
# A second skill is added to the throwaway repo copy AFTER the installs
# above, so the skill list really does change between the two runs. The
# config is not touched, so a moved timestamp can only come from the
# skill list.
#
# This runs last on purpose. Adding a skill changes what the installer
# writes, so it has to come after the checks that assert a settled
# state.
wait_for_next_second
mkdir -p "$BOUNDARY_REPO/config/skills/second-skill"
printf '# second skill\n' > "$BOUNDARY_REPO/config/skills/second-skill/SKILL.md"
config_sha_before_skills="$(sha256sum "$BOUNDARY_REPO/config/config.toml" | cut -d' ' -f1)"
set +e
idem_install "$BOUNDARY_REPO"
set -e
installed_at_skill_changed="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_ne "the recorded timestamp moves when the skill list changes" \
    "$installed_at_stable" "$installed_at_skill_changed"

# The config really was untouched, so the move above can only have come
# from the skill list.
config_sha_after_skills="$(sha256sum "$BOUNDARY_REPO/config/config.toml" | cut -d' ' -f1)"
assert_eq "the config was untouched while the skill list changed" \
    "$config_sha_before_skills" "$config_sha_after_skills"

# And the recorded skill list picked the new skill up.
recorded_after_skills="$(python3 -c \
    "import json;print(' '.join(json.load(open('$idem_state_file'))['skills']))")"
assert_eq "the recorded skill list picked the new skill up" \
    "second-skill swarm-engineering" "$recorded_after_skills"

# Put the skill list back the way it was, so the rest of the suite sees
# the same repo the README describes.
rm -rf "$BOUNDARY_REPO/config/skills/second-skill"

# And removing the skill again moves the timestamp once more, because
# the skill list changed back. The rule is "the timestamp moves when the
# skill list changed", and going back IS a change. This is the same
# trigger from the other direction.
wait_for_next_second
set +e
idem_install "$BOUNDARY_REPO"
set -e
installed_at_resettled="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_ne "the recorded timestamp moves when the skill list changes back" \
    "$installed_at_skill_changed" "$installed_at_resettled"

# And once the list is back to where it started, the timestamp holds
# again. Two installs with the same list are a no-op.
wait_for_next_second
set +e
idem_install "$BOUNDARY_REPO"
set -e
installed_at_held="$(python3 -c \
    "import json;print(json.load(open('$idem_state_file'))['installed_at'])")"
assert_eq "the recorded timestamp holds when the skill list settles" \
    "$installed_at_resettled" "$installed_at_held"

# ---------------------------------------------------------------------------
# 22. the uninstall confirmation and the state path fallback
# ---------------------------------------------------------------------------

echo ""
echo "=== uninstall confirmation and the state path fallback ==="

# With no --yes and no --dry-run, the script asks. At EOF it must abort
# without removing anything.
mkdir -p "$SANDBOX/confirm/home" "$SANDBOX/confirm/state"
cp "$REPO/config/config.toml" "$SANDBOX/confirm/home/config.toml"
set +e
confirm_out="$(HOME="$SANDBOX/confirm/home" XDG_STATE_HOME="$SANDBOX/confirm/state" \
    "$REPO/scripts/uninstall" --full < /dev/null 2>&1)"
confirm_rc=$?
set -e
assert_contains "uninstall aborts when the confirmation is not given" \
    "aborted." "$confirm_out"
assert_eq "uninstall exits 0 when the user declines" "0" "$confirm_rc"
if [[ -f "$SANDBOX/confirm/home/config.toml" ]]; then
    ok "a declined uninstall removes nothing"
else
    bad "a declined uninstall removes nothing" "config.toml was removed"
fi

# The state directory falls back to $HOME/.local/state when XDG_STATE_HOME
# is not set. The rest of the suite always sets it, so this path would
# otherwise never run.
mkdir -p "$SANDBOX/fallback/home"
set +e
HOME="$SANDBOX/fallback/home" XDG_STATE_HOME="" \
    "$REPO/scripts/install" >/dev/null 2>&1
fallback_rc=$?
set -e
assert_eq "install works without XDG_STATE_HOME" "0" "$fallback_rc"
if [[ -f "$SANDBOX/fallback/home/.local/state/lazible-jcode/state.json" ]]; then
    ok "the state file falls back to \$HOME/.local/state"
else
    bad "the state file falls back to \$HOME/.local/state" \
        "not found under $SANDBOX/fallback/home/.local/state"
fi

# ---------------------------------------------------------------------------
# 23. more than one skill
# ---------------------------------------------------------------------------

echo ""
echo "=== the repo can hold more than one skill ==="

# This repo ships exactly one skill, so the skill list the installer and
# the uninstaller build has only ever had one element in it. An array that
# is built in a loop has to work for more than one, so a second skill is
# added to a throwaway copy of the repo.
#
# A directory that is not a skill (no SKILL.md) is added too. It has to be
# ignored: it is not something this repo owns, so the installer must not
# copy it and the uninstaller must not remove it.
mkdir -p "$SANDBOX/multi"
cp -r "$REPO" "$SANDBOX/multi/repo"
rm -rf "$SANDBOX/multi/repo/.git"
mkdir -p "$SANDBOX/multi/repo/config/skills/second-skill"
printf '# second skill\n' > "$SANDBOX/multi/repo/config/skills/second-skill/SKILL.md"
mkdir -p "$SANDBOX/multi/repo/config/skills/not-a-skill"
printf 'stray\n' > "$SANDBOX/multi/repo/config/skills/not-a-skill/NOTES.md"

mkdir -p "$SANDBOX/multi/home" "$SANDBOX/multi/state"
set +e
HOME="$SANDBOX/multi/home" XDG_STATE_HOME="$SANDBOX/multi/state" \
    "$SANDBOX/multi/repo/scripts/install" >/dev/null 2>&1
multi_rc=$?
set -e
assert_eq "install succeeds with two skills" "0" "$multi_rc"

# What the live skills dir holds, for the failure messages.
multi_live="$(find "$SANDBOX/multi/home/.jcode/skills" -mindepth 1 -maxdepth 1 \
    -exec basename {} \; 2>/dev/null | sort | tr '\n' ' ')"

if [[ -f "$SANDBOX/multi/home/.jcode/skills/second-skill/SKILL.md" &&
      -f "$SANDBOX/multi/home/.jcode/skills/swarm-engineering/SKILL.md" ]]; then
    ok "install copies every skill in the repo"
else
    bad "install copies every skill in the repo" \
        "the live skills dir holds: $multi_live"
fi

if [[ ! -e "$SANDBOX/multi/home/.jcode/skills/not-a-skill" ]]; then
    ok "install ignores a directory that is not a skill"
else
    bad "install ignores a directory that is not a skill" \
        "not-a-skill was copied"
fi

# The recorded skill list has to name both skills, and only the real ones.
multi_recorded="$(python3 -c \
    "import json;print(' '.join(json.load(open('$SANDBOX/multi/state/lazible-jcode/state.json'))['skills']))" 2>/dev/null)"
assert_eq "the recorded skill list names both skills" \
    "second-skill swarm-engineering" "$multi_recorded"

# The uninstaller has to remove both. It builds its own list from the
# repo, so a list that stopped at the first element would leave the
# second skill behind.
set +e
HOME="$SANDBOX/multi/home" XDG_STATE_HOME="$SANDBOX/multi/state" \
    "$SANDBOX/multi/repo/scripts/uninstall" --full --yes >/dev/null 2>&1
multi_un_rc=$?
set -e
assert_eq "uninstall --full succeeds with two skills" "0" "$multi_un_rc"

if [[ ! -e "$SANDBOX/multi/home/.jcode/skills/second-skill" &&
      ! -e "$SANDBOX/multi/home/.jcode/skills/swarm-engineering" ]]; then
    ok "uninstall --full removes every skill in the repo"
else
    bad "uninstall --full removes every skill in the repo" \
        "the live skills dir holds: $(find "$SANDBOX/multi/home/.jcode/skills" -mindepth 1 -maxdepth 1 -exec basename {} \; 2>/dev/null | sort | tr '\n' ' ')"
fi

# A skill the repo does NOT own must survive the uninstall. This is the
# same promise the uninstaller makes in its own output.
mkdir -p "$SANDBOX/multi/home/.jcode/skills/someone-elses-skill"
printf 'not ours\n' > "$SANDBOX/multi/home/.jcode/skills/someone-elses-skill/SKILL.md"
HOME="$SANDBOX/multi/home" XDG_STATE_HOME="$SANDBOX/multi/state" \
    "$SANDBOX/multi/repo/scripts/uninstall" --full --yes >/dev/null 2>&1
if [[ -f "$SANDBOX/multi/home/.jcode/skills/someone-elses-skill/SKILL.md" ]]; then
    ok "uninstall leaves a skill this repo does not own"
else
    bad "uninstall leaves a skill this repo does not own" \
        "the other skill was removed"
fi

# ---------------------------------------------------------------------------
# 25. a repo with no skills at all
#
# The installer builds its skill list from a glob over config/skills/*/.
# When the repo has no skills, that glob matches nothing and the list is
# empty. The state writer had its own way of finding the skills, and it
# did not agree with the glob: it raised on a missing directory, which
# aborted the install in the LAST phase, after the config had already
# been copied. The install reported failure while leaving a half-finished
# result behind.
#
# So this case has to be exercised: a repo is allowed to ship no skills,
# and it has to install cleanly.
# ---------------------------------------------------------------------------

echo ""
echo "=== a repo with no skills at all ==="

mkdir -p "$SANDBOX/noskills"
cp -r "$REPO" "$SANDBOX/noskills/repo"
rm -rf "$SANDBOX/noskills/repo/.git"
rm -rf "$SANDBOX/noskills/repo/config/skills"
mkdir -p "$SANDBOX/noskills/home"

set +e
HOME="$SANDBOX/noskills/home" XDG_STATE_HOME="$SANDBOX/noskills/state" \
    "$SANDBOX/noskills/repo/scripts/install" >"$SANDBOX/noskills/out" 2>&1
noskills_rc=$?
set -e
assert_eq "install succeeds for a repo with no skills" "0" "$noskills_rc"

# The state file has to exist and record an EMPTY skill list. A crash in
# the state writer would leave no state file at all.
noskills_state="$SANDBOX/noskills/state/lazible-jcode/state.json"
if [[ -f "$noskills_state" ]]; then
    ok "install writes a state file for a repo with no skills"
else
    bad "install writes a state file for a repo with no skills" \
        "no state file at $noskills_state"
    bad "the state file records an empty skill list" \
        "no state file to read"
fi

if [[ -f "$noskills_state" ]]; then
    noskills_recorded="$(python3 -c \
        "import json;print(json.load(open('$noskills_state'))['skills'])")"
    assert_eq "the state file records an empty skill list" "[]" "$noskills_recorded"
fi

# The config still has to be installed. The bug was a crash in the LAST
# phase, so a passing exit code alone would not prove the earlier phases
# ran.
if [[ -f "$SANDBOX/noskills/home/.jcode/config.toml" ]]; then
    ok "install copies the config for a repo with no skills"
else
    bad "install copies the config for a repo with no skills" \
        "the config is missing"
fi

# And the uninstall has to handle the same repo.
set +e
HOME="$SANDBOX/noskills/home" XDG_STATE_HOME="$SANDBOX/noskills/state" \
    "$SANDBOX/noskills/repo/scripts/uninstall" --full --yes >/dev/null 2>&1
noskills_un_rc=$?
set -e
assert_eq "uninstall succeeds for a repo with no skills" "0" "$noskills_un_rc"

# ---------------------------------------------------------------------------
# 26. install --dry-run predicts the boundary refusal
#
# The uninstall dry-run is already checked to predict its own refusal.
# The install dry-run has to do the same: if a dry run said "this will
# work" and the real run refused, the preview would be a lie. The
# refusal happens in the preflight phase, which the dry run still runs,
# so the prediction has to hold.
# ---------------------------------------------------------------------------

echo ""
echo "=== install --dry-run predicts the boundary refusal ==="

mkdir -p "$SANDBOX/dryrefuse/home/.jcode"
ln -s "$BOUNDARY_REPO/config/config.toml" \
    "$SANDBOX/dryrefuse/home/.jcode/config.toml"

set +e
dryrefuse_out="$(HOME="$SANDBOX/dryrefuse/home" \
    XDG_STATE_HOME="$SANDBOX/dryrefuse/state" \
    "$BOUNDARY_REPO/scripts/install" --dry-run 2>&1)"
dryrefuse_rc=$?
set -e

assert_eq "install --dry-run exits 1 on a boundary violation" \
    "1" "$dryrefuse_rc"
if grep -q 'resolves inside this repo' <<<"$dryrefuse_out" &&
   grep -q 'refuses to touch it' <<<"$dryrefuse_out"; then
    ok "install --dry-run reports the boundary refusal"
else
    bad "install --dry-run reports the boundary refusal" \
        "the dry run did not report the refusal"
fi

# A dry run must not have side effects. The refusal is up front, so
# nothing may have been written.
if [[ ! -e "$SANDBOX/dryrefuse/state/lazible-jcode/state.json" ]]; then
    ok "a refused install --dry-run writes no state file"
else
    bad "a refused install --dry-run writes no state file" \
        "a state file was written"
fi

# ---------------------------------------------------------------------------

echo ""
echo "$pass passed, $fail failed"
[[ $fail -eq 0 ]] || exit 1
