#!/usr/bin/env bash
# verify-sanitized : pre-commit check that no tokens or paths leak.
#
# Checks:
#   1. config/config.toml is parseable
#   2. No hardcoded /home/<user> paths in config.toml
#   3. All known sensitive keys are empty or placeholders
#   4. No hardcoded /home/<user> paths in machine-consumed config
#   5. Skill files have no long tokens (coarse check)
#   6. ~/.jcode/config.toml is not a symlink (prevents live writes flowing back into repo)
#   7. Live config vs repo config drift (warn, not fail)

set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
config_toml="${repo}/config/config.toml"
skills_dir="${repo}/config/skills"
live_config="${JCODE_HOME:-$HOME/.jcode}/config.toml"

fail=0
warn=0
note() { printf "  %s\n" "$*"; }
err()  { printf "  ✗ %s\n" "$*"; fail=1; }
warn_msg() { printf "  ⚠ %s\n" "$*"; warn=1; }
ok()   { printf "  ✓ %s\n" "$*"; }

# 1. TOML parse
if python3 - "$config_toml" <<'PY'
import sys, tomllib
tomllib.load(open(sys.argv[1], 'rb'))
PY
then
    ok "config/config.toml parses"
else
    err "config/config.toml parse failed"
fi

# 2. Hardcoded /home/<user>
if grep -nE '/home/[a-z]+' "$config_toml" 2>/dev/null; then
    err "config/config.toml has hardcoded /home/..."
else
    ok "no /home/... in config.toml"
fi

# 3. Sensitive-key masking (walks by schema path, matching real field names)
python3 - "$config_toml" <<'PY' || { err "config.toml secret leak"; }
import sys, tomllib
data = tomllib.load(open(sys.argv[1], 'rb'))
SECRET_KEYS = {
    'api_key', 'api-key', 'apikey',
    'token', 'bearer',
    'password', 'secret',
    'ntfy_topic', 'telegram_bot_token', 'discord_bot_token',
    'email_password', 'jade_relay_token', 'bing_api_key',
}
def walk(obj, path=()):
    if isinstance(obj, dict):
        for k, v in obj.items():
            walk(v, path + (k,))
    elif isinstance(obj, str):
        key = path[-1].lower() if path else ''
        if key in SECRET_KEYS:
            if obj and not obj.startswith('~') and obj != '':
                print(f'leak: {".".join(path)} = {obj!r}')
                sys.exit(1)
walk(data)
PY
ok "config.toml secret scan"

# 4. No hardcoded /home/<user> in machine-consumed config.
# policies/, templates/ and skills/ are prose: they legitimately show example
# paths, so they are exempt.
machine_paths=(
    "$config_toml"
    "$repo/config/mcp.example.json"
)
for d in "$repo/config/bin" "$repo/config/share"; do
    [[ -d "$d" ]] && machine_paths+=("$d")
done

path_hits=0
for target in "${machine_paths[@]}"; do
    if [[ -f "$target" ]]; then
        target_paths=("$target")
    else
        target_paths=()
        while IFS= read -r f; do target_paths+=("$f"); done \
            < <(find "$target" -type f -not -path '*/__pycache__/*' 2>/dev/null)
    fi
    if [[ ${#target_paths[@]} -eq 0 ]]; then
        continue
    fi
    hits="$(grep -nE '/home/[a-z]+' "${target_paths[@]}" 2>/dev/null || true)"
    if [[ -n "$hits" ]]; then
        printf '%s\n' "$hits"
        err "hardcoded /home/... in ${target#"$repo"/}"
        path_hits=1
    fi
done
if [[ $path_hits -eq 0 ]]; then
    ok "no /home/... in machine-consumed config"
fi

# 5. Skill files long tokens (coarse)
if [[ -d "$skills_dir" ]]; then
    if grep -rnE '\b[A-Za-z0-9_-]{40,}\b' "$skills_dir" 2>/dev/null | grep -v README; then
        err "long token-looking string in skills/"
    else
        ok "skills/ no long tokens"
    fi
fi

# 6. Live config must not be a symlink (a write through it lands in the repo base)
if [[ -L "$live_config" ]]; then
    err "$live_config is a symlink -> $(readlink "$live_config")"
    note "    install refuses to write through it. Fix:"
    note "    rm $live_config && cp $repo/config/config.toml $live_config"
else
    ok "live config is a regular file"
fi

# 7. Live vs repo config drift (warn only: install is the thing that fixes it)
if [[ -f "$live_config" && ! -L "$live_config" ]]; then
    diff_count=$(python3 - "$live_config" "$config_toml" 2>/dev/null <<'PYEOF'
import sys, tomllib
live_d = tomllib.load(open(sys.argv[1], 'rb'))
base_d = tomllib.load(open(sys.argv[2], 'rb'))
def walk(a, b):
    if isinstance(a, dict) and isinstance(b, dict):
        n = 0
        for k in set(a) | set(b):
            n += walk(a.get(k), b.get(k))
        return n
    return 0 if a == b else 1
print(walk(base_d, live_d))
PYEOF
)
    if [[ "$diff_count" -gt 0 ]] 2>/dev/null; then
        warn_msg "live config differs from repo config in $diff_count leaves"
        note "    run ./scripts/diff-live-base for details, then ./scripts/install to resync"
    else
        ok "live config matches repo config/config.toml"
    fi
fi

echo
if [[ $fail -ne 0 ]]; then
    echo "FAIL: sanitization checks failed"
    exit 1
elif [[ $warn -ne 0 ]]; then
    echo "OK with warnings"
else
    echo "ALL OK"
fi