#!/usr/bin/env bash
# snapshot-config : copy ~/.jcode/config.toml to config/config.toml and
# sanitize it.
#
# Usage:
#   ./scripts/snapshot-config             # default: --dry-run (just print what would change)
#   ./scripts/snapshot-config --apply     # actually write to repo (DESTRUCTIVE; overwrites config/config.toml)
#   ./scripts/snapshot-config --diff      # show structural drift only (no write, no mask)
#
# Sanitization rules (same as verify-sanitized):
#   - Parse TOML; walk by schema path
#   - Non-empty strings at known sensitive keys → "~/<PLACEHOLDER>"
#   - Replace hardcoded /home/<user> paths with ~/
#   - Output preserves original file structure but values are masked
#
# Important: this script WRITES to the repo's config/config.toml. Confirm the
# live config is the state you want to commit first.
#
# Default is --dry-run so accidental invocations don't pollute the repo base.
# Use --apply to actually perform the write.

set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
src="${JCODE_HOME:-$HOME/.jcode}/config.toml"
dst="${repo}/config/config.toml"

mode="dry-run"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --apply) mode="apply"; shift ;;
        --dry-run) mode="dry-run"; shift ;;
        --diff) mode="diff"; shift ;;
        -h|--help)
            sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

[[ -f "$src" ]] || { echo "no source: $src" >&2; exit 1; }

if [[ -L "$src" ]]; then
    echo "✗ $src is a symlink → $(readlink "$src")" >&2
    echo "  snapshot-config would write through it to the repo." >&2
    echo "  Break the symlink first:" >&2
    echo "    rm $src && cp <repo>/config/config.toml $src" >&2
    exit 3
fi

# --diff: structural drift only (read both files, print diff). No write.
if [[ "$mode" == "diff" ]]; then
    python3 - "$src" "$dst" <<'PY'
import sys, tomllib
src, dst = sys.argv[1], sys.argv[2]
a = tomllib.load(open(src, 'rb'))
b = tomllib.load(open(dst, 'rb'))
def walk(x, y, path=''):
    if isinstance(x, dict) and isinstance(y, dict):
        for k in sorted(set(x) | set(y)):
            yield from walk(x.get(k), y.get(k), f"{path}.{k}" if path else k)
    elif x != y:
        yield (path, x, y)
n = 0
for p, av, bv in walk(a, b):
    n += 1
    print(f"  {p}: {av!r} → {bv!r}")
print(f"--diff: {n} leaves differ (live → base)")
PY
    exit 0
fi

# --dry-run: compute the masked snapshot into a buffer, print summary, do not write.
if [[ "$mode" == "dry-run" ]]; then
    python3 - "$src" "$dst" "${repo}/scripts" <<'PY' > /tmp/snapshot-config-preview.txt
import sys, re, pathlib, tomllib
sys.path.insert(0, sys.argv[3])
import _lib_toml as L

src, dst = sys.argv[1], sys.argv[2]

with open(src, 'rb') as f:
    data = tomllib.load(f)

masked = L.mask_secrets(data)
output = L.emit(masked)
output = re.sub(r'/home/\w+', '~', output)
sys.stdout.write(output)
PY
    preview_bytes=$(wc -c < /tmp/snapshot-config-preview.txt | tr -d ' ')
    echo "[dry-run] would write ${preview_bytes}-byte masked snapshot to: $dst"
    echo "[dry-run] no changes made. re-run with --apply to actually write."
    echo
    echo "--- diff vs current $dst (preview, first 20 lines): ---"
    diff -u "$dst" /tmp/snapshot-config-preview.txt 2>&1 | head -20
    rm -f /tmp/snapshot-config-preview.txt
    exit 0
fi

python3 - "$src" "$dst" "${repo}/scripts" <<'PY'
import sys, re, pathlib, tomllib
sys.path.insert(0, sys.argv[3])
import _lib_toml as L

src, dst = sys.argv[1], sys.argv[2]

# 1. Parse to know which keys to mask
with open(src, 'rb') as f:
    data = tomllib.load(f)

masked = L.mask_secrets(data)

# 2. Re-emit using the shared emitter
with open(dst, 'w') as f:
    f.write(L.emit(masked))

# 3. Path replacement (for hardcoded /home/<user> outside of $HOME / $JCODE_HOME env vars)
text = pathlib.Path(dst).read_text()
text = re.sub(r'/home/\w+', '~', text)
pathlib.Path(dst).write_text(text)
PY

echo "✓ sanitized snapshot → $dst"
echo "  review with: git diff config/config.toml"